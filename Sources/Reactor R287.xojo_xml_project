   <PartID>962930687</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub FileReceived(URL As String, HTTPStatus As Integer, file As FolderItem)</SourceLine>
    <SourceLine>#PRAGMA unused URL</SourceLine>
    <SourceLine>#PRAGMA unused HTTPStatus</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>DownloadProgress.Value = DownloadProgress.MaximumValue</SourceLine>
    <SourceLine>DownloadProgress.Indeterminate = False</SourceLine>
    <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + " Downloaded"</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>System.Debuglog("[Downloaded Package] " + file.NativePath)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>AtomDeployFiles()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Update the downloading status line</SourceLine>
