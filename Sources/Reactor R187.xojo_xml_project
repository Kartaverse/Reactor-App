    <Method>
      <ItemName>Download</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>6021119</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Download(url As String, path As FolderItem)</SourceLine>
        <SourceLine>// Get filename from URL</SourceLine>
        <SourceLine>Var filenameLength As Integer</SourceLine>
        <SourceLine>For i As Integer = url.Length - 1 DownTo 0</SourceLine>
        <SourceLine>If url.Middle(i, 1) = "/" Then</SourceLine>
        <SourceLine>filenameLength = url.Length - i</SourceLine>
        <SourceLine>Exit For</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>Var filename As String</SourceLine>
        <SourceLine>filename = url.Right(filenameLength).ReplaceAll("/", "")</SourceLine>
        <SourceLine/>
        <SourceLine>Var downloadFile As FolderItem = path</SourceLine>
        <SourceLine>App.DownloadFilename = downloadFile.Name</SourceLine>
        <SourceLine>App.DownloadFolderItem = downloadFile</SourceLine>
        <SourceLine/>
        <SourceLine>// Download the file</SourceLine>
        <SourceLine>RSocket.Send("GET", url, downloadFile)</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams>url As String, path As FolderItem</ItemParams>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>CategoryRefresh</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1107865599</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub CategoryRefresh()</SourceLine>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>CategoryListBox.RemoveAllRows()</SourceLine>
        <SourceLine>CategoryListBox.AddExpandableRow( "All")</SourceLine>
        <SourceLine>CategoryListBox.RowTagAt(CategoryListBox.LastAddedRowIndex) = "All"</SourceLine>
        <SourceLine>CategoryListBox.RowExpandableAt(0) = False </SourceLine>
        <SourceLine/>
        <SourceLine>Var Depth As Integer = 0</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomCategoryArray() As String</SourceLine>
        <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
        <SourceLine/>
        <SourceLine>If Depth &lt;= AtomCategoryArray.Count - 1 then</SourceLine>
        <SourceLine>If Depth = 0 then</SourceLine>
        <SourceLine>// Scan through the Category segments</SourceLine>
        <SourceLine>Var ExcludeItem as Boolean = False</SourceLine>
        <SourceLine>Var row As Integer</SourceLine>
        <SourceLine>For row = 0 To CategoryListBox.LastRowIndex</SourceLine>
        <SourceLine>If Depth = CategoryListBox.RowDepthAt(row) - 1 And CategoryListBox.CellTextAt(row) = AtomCategoryArray(Depth) Then </SourceLine>
        <SourceLine>ExcludeItem = True</SourceLine>
        <SourceLine>Exit For row // or Return if inside method</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>If Not ExcludeItem then</SourceLine>
        <SourceLine>CategoryListBox.AddRowAt(CategoryListBox.LastAddedRowIndex, AtomCategoryArray(Depth), Depth + 1)</SourceLine>
        <SourceLine>CategoryListBox.CellTextAt(CategoryListBox.LastAddedRowIndex) = AtomCategoryArray(Depth)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>CategoryListBox.Sort</SourceLine>
        <SourceLine/>
        <SourceLine>// Reset the category selection to All</SourceLine>
        <SourceLine>If CategoryListbox.RowCount &gt;= 1 Then</SourceLine>
        <SourceLine>CategoryListbox.SelectedRowIndex = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams/>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>AtomsRefresh</ItemName>
      <Compatibility/>
