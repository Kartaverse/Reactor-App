      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub CreateReactorFolders()</SourceLine>
        <SourceLine>// By default the Reactor folder is stored in the user's home account</SourceLine>
        <SourceLine>Var TempFolder As FolderItem = SpecialFolder.Temporary.Child("Reactor")</SourceLine>
        <SourceLine/>
        <SourceLine>Var ReactorFolder As FolderItem = SpecialFolder.UserHome.Child("Reactor")</SourceLine>
        <SourceLine>Var JSONFolder As FolderItem = ReactorFolder.Child("JSON")</SourceLine>
        <SourceLine>Var AtomzFolder As FolderItem = ReactorFolder.Child("Atomz")</SourceLine>
        <SourceLine>Var AtomsFolder As FolderItem = ReactorFolder.Child("Atoms")</SourceLine>
        <SourceLine>Var AtomsReactorFolder As FolderItem = AtomsFolder.Child("Reactor")</SourceLine>
        <SourceLine>Var DeployFolder As FolderItem = ReactorFolder.Child("Deploy")</SourceLine>
        <SourceLine>Var DeployAtomsFolder As FolderItem = DeployFolder.Child("Atoms")</SourceLine>
        <SourceLine>Var DeployAtomsReactorFolder As FolderItem = DeployAtomsFolder.Child("Reactor")</SourceLine>
        <SourceLine>Var DeployJSONFolder As FolderItem = DeployFolder.Child("JSON")</SourceLine>
        <SourceLine>Var DeployJSONReactorFolder As FolderItem = DeployJSONFolder.Child("Reactor")</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the folders</SourceLine>
        <SourceLine>If TempFolder &lt;&gt; Nil And Not TempFolder.Exists Then</SourceLine>
        <SourceLine>TempFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If ReactorFolder &lt;&gt; Nil And Not ReactorFolder.Exists Then</SourceLine>
        <SourceLine>ReactorFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If JSONFolder &lt;&gt; Nil And Not JSONFolder.Exists Then</SourceLine>
        <SourceLine>JSONFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If AtomzFolder &lt;&gt; Nil And Not AtomzFolder.Exists Then</SourceLine>
        <SourceLine>AtomzFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If AtomsFolder &lt;&gt; Nil And Not AtomsFolder.Exists Then</SourceLine>
        <SourceLine>AtomsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If AtomsReactorFolder &lt;&gt; Nil And Not AtomsReactorFolder.Exists Then</SourceLine>
        <SourceLine>AtomsReactorFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If DeployFolder &lt;&gt; Nil And Not DeployFolder.Exists Then</SourceLine>
        <SourceLine>DeployFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If DeployAtomsFolder &lt;&gt; Nil And Not DeployAtomsFolder.Exists Then</SourceLine>
        <SourceLine>DeployAtomsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If DeployAtomsReactorFolder &lt;&gt; Nil And Not DeployAtomsReactorFolder.Exists Then</SourceLine>
        <SourceLine>DeployAtomsReactorFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If DeployJSONFolder &lt;&gt; Nil And Not DeployJSONFolder.Exists Then</SourceLine>
        <SourceLine>DeployJSONFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If DeployJSONReactorFolder &lt;&gt; Nil And Not DeployJSONReactorFolder.Exists Then</SourceLine>
        <SourceLine>DeployJSONReactorFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
