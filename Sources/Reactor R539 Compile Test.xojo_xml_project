        <Visible>1</Visible>
        <PartID>1111216127</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintHeaderContent(g As Graphics, column As Integer) As Boolean</SourceLine>
          <SourceLine>// JustCropIt ListBox Header Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(42, 42, 42)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Dark Grey Outline Stroke</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(21, 21, 21)</SourceLine>
          <SourceLine>g.DrawLine(g.Width - 1, 0, g.Width - 1, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Column selection bold highlight</SourceLine>
          <SourceLine>If Me.HeadingIndex = column Then</SourceLine>
          <SourceLine>// Font Bold</SourceLine>
          <SourceLine>g.Bold = True</SourceLine>
          <SourceLine/>
          <SourceLine>If color.IsDarkMode Then</SourceLine>
          <SourceLine>// JustCropIt Yellow</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 206, 30)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Yellow</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 206, 30)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var gY as Double = (g.Height - g.TextHeight) / 2 + g.FontAscent</SourceLine>
          <SourceLine>Var gX As Double = g.width - 10</SourceLine>
          <SourceLine>g.DrawText(me.HeaderAt(column), 5, gY, gX, True)</SourceLine>
          <SourceLine/>
          <SourceLine>If Me.ColumnSortDirectionAt(column) = DesktopListBox.SortDirections.Ascending Then</SourceLine>
          <SourceLine>g.DrawPicture(ChevronUp, g.width - 15, 7)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>g.DrawPicture(ChevronDown, g.width - 15, 7)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(155, 155, 155)</SourceLine>
          <SourceLine>var gY as double = (g.Height - g.TextHeight) / 2 + g.FontAscent</SourceLine>
          <SourceLine>g.DrawText(me.HeaderAt(column), 5, gY, g.width -10, True)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Return True</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
