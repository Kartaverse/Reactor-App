 </Method>
 <Method>
  <ItemName>AtomRemoveByRow</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>310880255</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomRemoveByRow(row As Integer)</SourceLine>
   <SourceLine>If row &gt;= 0 Then</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(row, 6) = "Removing"</SourceLine>
   <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
   <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var CellString As String = AtomsListBox.CellTextAt(row, 1)</SourceLine>
   <SourceLine>Var AtomIndex As Integer = AtomsListBox.CellTagAt(row, 1).IntegerValue</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
   <SourceLine>Var AtomDeploy As JSONItem = Atom.Value("Deploy")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
   <SourceLine>Var ZipFileURL As String =  Atom.Value("Zipfile")</SourceLine>
   <SourceLine>Var AtomzFile As FolderItem = App.AtomzFolder.Child(AtomID + ".zip")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Remove the partial file</SourceLine>
   <SourceLine>If AtomzFile &lt;&gt; Nil And AtomzFile.Exists then</SourceLine>
   <SourceLine>AtomzFile.Remove()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Remove the atom deploy file records</SourceLine>
   <SourceLine>Var DeployAtomsFile As FolderItem = App.DeployAtomsReactorFolder.Child(AtomID + ".atom")</SourceLine>
   <SourceLine>Var DeployJSONFile As FolderItem = App.DeployJSONReactorFolder.Child(AtomID + ".json")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployAtomsFile &lt;&gt; Nil And DeployAtomsFile.Exists then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing file</SourceLine>
   <SourceLine>DeployAtomsFile.Remove()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If DeployJSONFile &lt;&gt; Nil And DeployJSONFile.Exists then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing file</SourceLine>
   <SourceLine>DeployJSONFile.Remove()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Deploy files</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If AtomDeploy.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As String In AtomDeploy.Keys</SourceLine>
   <SourceLine>if k &lt;&gt; "Mac" and k &lt;&gt; "Windows" and k &lt;&gt; "Linux" Then</SourceLine>
   <SourceLine>// Common Files</SourceLine>
   <SourceLine>Var DeployVariant As Variant = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>ElseIf k = "Mac" and TargetMacOS Then</SourceLine>
   <SourceLine>// macOS Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Windows" and TargetWindows Then</SourceLine>
   <SourceLine>// Windows Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Linux" and TargetLinux Then</SourceLine>
   <SourceLine>// Linux Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Refresh the status displays</SourceLine>
   <SourceLine>DownloadStatsLabel.Text = AtomzFile.Name + " Removed"</SourceLine>
   <SourceLine>DownloadProgress.Indeterminate = False</SourceLine>
   <SourceLine>DownloadProgress.Value = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>For i As Integer = 0 to App.DownloadList.Count - 1</SourceLine>
   <SourceLine>If App.DownloadList(i) = AtomID Then</SourceLine>
   <SourceLine>App.DownloadList.Remove(i)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>App.DownloadList.Sort</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>row As Integer</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>AtomURL</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>481331199</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomURL(AtomID As String)</SourceLine>
   <SourceLine>// This method supports the Reactor:/&lt;AtomID&gt; website URL syntax</SourceLine>
   <SourceLine>// Clicking a Reactor weblink in a web browswer causes the Reactor app</SourceLine>
   <SourceLine>// to navigate to the selected atom package in the AtomsListBox view</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If AtomID &lt;&gt; "" Then</SourceLine>
   <SourceLine>Var row As Integer</SourceLine>
   <SourceLine>For row = 0 To CategoryListBox.LastRowIndex</SourceLine>
   <SourceLine>If CategoryListBox.CellTextAt(row, 0) = "All" Then </SourceLine>
   <SourceLine>CategoryListBox.SelectedRowIndex = row</SourceLine>
   <SourceLine>CategoryListBox.SetFocus</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>For row = 0 To AtomsListBox.LastRowIndex</SourceLine>
   <SourceLine>If AtomsListBox.CellTextAt(row, 8) = AtomID Then </SourceLine>
   <SourceLine>AtomsListBox.SelectedRowIndex = row</SourceLine>
   <SourceLine>AtomsListBox.SetFocus</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
