 <Method>
  <ItemName>WriteCurrentLine</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>766040063</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub WriteCurrentLine()</SourceLine>
   <SourceLine>Var indentation As Text</SourceLine>
   <SourceLine>For i As Integer = 1 To IndentLevel</SourceLine>
   <SourceLine>indentation = indentation + "    "</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var line As Text = indentation + CurrentLine.Trim</SourceLine>
   <SourceLine>If line.Length &gt; 0 Then</SourceLine>
   <SourceLine>FormattedJSON = FormattedJSON + line + EndOfLine.Unix.ToText</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>CurrentLine = ""</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
