  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SaveAtomzList()</SourceLine>
   <SourceLine>// Save an atoms list file to disk</SourceLine>
   <SourceLine>Var ReactorAtomzListFile As FolderItem = App.ReactorFolder.Child("Atomz").Child("Atom Packages.lst")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Create the file pointer</SourceLine>
   <SourceLine>Var fileStream As TextOutputStream = TextOutputStream.Create(ReactorAtomzListFile)</SourceLine>
   <SourceLine>If fileStream &lt;&gt; Nil Then</SourceLine>
   <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>// Write the data to disk</SourceLine>
   <SourceLine>fileStream.WriteLine(AtomID + ".zip")</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Close the filepointer</SourceLine>
