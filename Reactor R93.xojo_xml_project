      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub JSONDownload()</SourceLine>
        <SourceLine>// Working folder</SourceLine>
        <SourceLine>Var JSONFolder As FolderItem = SpecialFolder.UserHome.Child("Reactor").Child("JSON")</SourceLine>
        <SourceLine/>
        <SourceLine>// Download the JSON file</SourceLine>
        <SourceLine>Var url As String = "https://kartaverse.github.io/Reactor-Docs/JSON/Reactor.json"</SourceLine>
        <SourceLine>Var JSONFile As FolderItem = JSONFolder.Child("Reactor.json")</SourceLine>
        <SourceLine/>
        <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
        <SourceLine>CreateReactorFolders()</SourceLine>
        <SourceLine/>
        <SourceLine>// Socket</SourceLine>
        <SourceLine>RSocket.ClearRequestHeaders</SourceLine>
        <SourceLine>RSocket.RequestHeader("User-Agent") = "Xojo"</SourceLine>
        <SourceLine>RSocket.AllowCertificateValidation = false</SourceLine>
        <SourceLine/>
        <SourceLine>App.DownloadFilename = "Reactor.json"</SourceLine>
        <SourceLine>App.DownloadFolderItem = JSONFile</SourceLine>
        <SourceLine>App.Atoms = New JSONItem(RSocket.SendSync("GET", url, 5))</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + "100% "</SourceLine>
        <SourceLine/>
        <SourceLine>Var options As New JSONOptions</SourceLine>
        <SourceLine>options.Compact = False</SourceLine>
        <SourceLine>options.IndentSpacing = 4</SourceLine>
        <SourceLine/>
        <SourceLine>Var tos As TextOutputStream</SourceLine>
        <SourceLine>If JSONFile &lt;&gt; Nil Then</SourceLine>
        <SourceLine>tos = TextOutputStream.Create(JSONFile)</SourceLine>
        <SourceLine>If tos &lt;&gt; Nil Then</SourceLine>
        <SourceLine>tos.Write(App.Atoms.ToString(options))</SourceLine>
        <SourceLine>tos.Close</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
