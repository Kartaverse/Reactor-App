   <PartID>235296767</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>Var mManager As GameInputManager = New GameInputManager</SourceLine>
    <SourceLine>Var gCount As Integer = mManager.DeviceCount</SourceLine>
    <SourceLine>Var device As GameInputDevice</SourceLine>
    <SourceLine>Var deviceID As Integer = 0</SourceLine>
    <SourceLine>Var deviceName As String = ""</SourceLine>
    <SourceLine>Var i as Integer = 0</SourceLine>
    <SourceLine>For deviceID = 0 To gCount - 1</SourceLine>
    <SourceLine>device = mManager.Device(deviceID)</SourceLine>
    <SourceLine>If mManager.Device(deviceID) &lt;&gt; Nil Then</SourceLine>
    <SourceLine>deviceName =  mManager.Device(deviceID).Name</SourceLine>
    <SourceLine>//MessageBox(deviceName)</SourceLine>
    <SourceLine>//System.Debuglog("""" + deviceName + """")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Supported devices:</SourceLine>
    <SourceLine>// DualSense Wireless Controller</SourceLine>
    <SourceLine>// SpaceMouse Enterprise</SourceLine>
    <SourceLine>// Kinesis JoyStick Controller</SourceLine>
    <SourceLine>If deviceName = "Kinesis JoyStick Controller " Then</SourceLine>
    <SourceLine>For i = 0 To device.ElementCount - 1</SourceLine>
    <SourceLine>Var mButton As GameInputElement = device.Element(i)</SourceLine>
    <SourceLine>If mButton &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var mButtonName As String = mButton.Name</SourceLine>
    <SourceLine>Var mButtonState As String =  mButton.Value.ToString</SourceLine>
    <SourceLine>//MessageBox(mButtonName + " | " + mButtonState)</SourceLine>
    <SourceLine>If mButtonName = "Button #1" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Left Button</SourceLine>
    <SourceLine>Quit()</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #3" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Right Button</SourceLine>
    <SourceLine>ReactorWindow.Show</SourceLine>
    <SourceLine>LicenseWindow.Close</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>ElseIf deviceName = "DualSense Wireless Controller" Then</SourceLine>
    <SourceLine>For i = 0 To device.ElementCount - 1</SourceLine>
    <SourceLine>Var mButton As GameInputElement = device.Element(i)</SourceLine>
    <SourceLine>If mButton &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var mButtonName As String = mButton.Name</SourceLine>
    <SourceLine>Var mButtonState As String =  mButton.Value.ToString</SourceLine>
    <SourceLine>// Look into the analog joysticks for adjustable speed control</SourceLine>
    <SourceLine>If mButtonName = "Button #1" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Square Button = Cancel</SourceLine>
    <SourceLine>Quit()</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #2" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// X botton to toggle License Agree</SourceLine>
    <SourceLine>ReactorWindow.Show</SourceLine>
    <SourceLine>LicenseWindow.Close</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>Catch error As RuntimeException</SourceLine>
    <SourceLine>System.DebugLog("Warning... USB Down"  + EndOfLine + EndOfLine + error.Message)</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
