          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellBackground(g As Graphics, row As Integer, column As Integer) As Boolean</SourceLine>
          <SourceLine>// Draw the listbox row shading</SourceLine>
          <SourceLine>// For ListBox multi-selection row shading look at "Me.Selected(row)"</SourceLine>
          <SourceLine>If row = Me.SelectedRowIndex Then</SourceLine>
          <SourceLine>// Selected Row Shading</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>ElseIf row Mod 2 = 0 Then</SourceLine>
          <SourceLine>// Secondary Row Shading</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(41, 41, 41)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Primary Row Shading</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(34, 34, 34)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
