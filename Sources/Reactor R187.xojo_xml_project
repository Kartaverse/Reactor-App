    <ControlBehavior>
      <Superclass>RESTSocket</Superclass>
      <HookInstance>
        <ItemName>ReceivingProgressed</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>977092607</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub ReceivingProgressed(bytesReceived As Int64, totalBytes As Int64, newData As String)</SourceLine>
          <SourceLine>#PRAGMA unused newData</SourceLine>
          <SourceLine/>
          <SourceLine>CancelButton.Visible = True</SourceLine>
          <SourceLine>DownloadProgress.Visible = True</SourceLine>
          <SourceLine>DownloadProgress.Value = (bytesReceived / totalBytes) * 100</SourceLine>
          <SourceLine/>
          <SourceLine>If App.DownloadRow &gt;= 0 and App.DownloadRow &lt;= AtomsListBox.RowCount - 1  Then</SourceLine>
          <SourceLine>AtomsListBox.CellTagAt(App.DownloadRow, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
          <SourceLine>AtomsListBox.CellCheckBoxStateAt(App.DownloadRow, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
          <SourceLine>AtomsListBox.CellTextAt(App.DownloadRow, 6) = "Downloading"</SourceLine>
          <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(App.DownloadRow, c)</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var megabytesReceived As Double = bytesReceived / 1000000</SourceLine>
          <SourceLine>Var totalmegabytes As Double = totalBytes / 1000000</SourceLine>
          <SourceLine/>
          <SourceLine>If totalBytes = -1 then</SourceLine>
          <SourceLine>// Unknown download size</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + megabytesReceived.ToString(Locale.Current, "#,##0.00") + " MB "</SourceLine>
          <SourceLine>DownloadProgress.Indeterminate = True</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Known download size</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + megabytesReceived.ToString(Locale.Current, "#,##0.00") + " MB of " + totalmegabytes.ToString(Locale.Current, "#,##0.00") + " MB "</SourceLine>
          <SourceLine>DownloadProgress.Indeterminate = False</SourceLine>
          <SourceLine>// "com.Vonk.FusionMograph.zip 6.9 MB of 600 MB (929 kB/sec)"</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>FileReceived</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>962930687</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub FileReceived(URL As String, HTTPStatus As Integer, file As FolderItem)</SourceLine>
