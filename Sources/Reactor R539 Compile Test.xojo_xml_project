          <SourceLine/>
          <SourceLine>// State package count</SourceLine>
          <SourceLine>// If column = 1 Then</SourceLine>
          <SourceLine>// JustCropIt Dark Grey Outline Stroke</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(21, 21, 21)</SourceLine>
          <SourceLine>g.DrawLine(g.Width - 1, 0, g.Width - 1, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Font</SourceLine>
          <SourceLine>g.FontName = "Inter"</SourceLine>
          <SourceLine/>
          <SourceLine>// Disable Bold Text for the item count</SourceLine>
          <SourceLine>g.Bold = False</SourceLine>
