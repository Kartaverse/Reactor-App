      <PartID>6021119</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Download(url As String, path As FolderItem)</SourceLine>
        <SourceLine>// Get filename from URL</SourceLine>
        <SourceLine>Var filenameLength As Integer</SourceLine>
        <SourceLine>For i As Integer = url.Length - 1 DownTo 0</SourceLine>
        <SourceLine>If url.Middle(i, 1) = "/" Then</SourceLine>
        <SourceLine>filenameLength = url.Length - i</SourceLine>
        <SourceLine>Exit For</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>Var filename As String</SourceLine>
        <SourceLine>filename = url.Right(filenameLength).ReplaceAll("/", "")</SourceLine>
        <SourceLine/>
        <SourceLine>Var downloadFile As FolderItem = path</SourceLine>
        <SourceLine>App.DownloadFilename = downloadFile.Name</SourceLine>
        <SourceLine>App.DownloadFolderItem = downloadFile</SourceLine>
        <SourceLine>RSocket.Send("GET", url, downloadFile)</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams>url As String, path As FolderItem</ItemParams>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>CategoryRefresh</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1107865599</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub CategoryRefresh()</SourceLine>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>CategoryListBox.RemoveAllRows()</SourceLine>
        <SourceLine>CategoryListBox.AddExpandableRow( "All")</SourceLine>
        <SourceLine>CategoryListBox.RowTagAt(CategoryListBox.LastAddedRowIndex) = "All"</SourceLine>
        <SourceLine>CategoryListBox.RowExpandableAt(0) = False </SourceLine>
        <SourceLine/>
        <SourceLine>Var Depth As Integer = 0</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomCategoryArray() As String</SourceLine>
        <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
        <SourceLine/>
        <SourceLine>If Depth &lt;= AtomCategoryArray.Count - 1 then</SourceLine>
        <SourceLine>If Depth = 0 then</SourceLine>
        <SourceLine>// Scan through the Category segments</SourceLine>
        <SourceLine>Var ExcludeItem as Boolean = False</SourceLine>
        <SourceLine>Var row As Integer</SourceLine>
        <SourceLine>For row = 0 To CategoryListBox.LastRowIndex</SourceLine>
        <SourceLine>If Depth = CategoryListBox.RowDepthAt(row) - 1 And CategoryListBox.CellTextAt(row) = AtomCategoryArray(Depth) Then </SourceLine>
        <SourceLine>ExcludeItem = True</SourceLine>
        <SourceLine>Exit For row // or Return if inside method</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>If Not ExcludeItem then</SourceLine>
        <SourceLine>CategoryListBox.AddRowAt(CategoryListBox.LastAddedRowIndex, AtomCategoryArray(Depth), Depth + 1)</SourceLine>
        <SourceLine>CategoryListBox.CellTextAt(CategoryListBox.LastAddedRowIndex) = AtomCategoryArray(Depth)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>CategoryListBox.Sort</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams/>
      <ItemResult/>
    </Method>
    <Method>
      <ItemName>AtomsRefresh</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1056473087</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomsRefresh()</SourceLine>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>Var AtomCount As Integer = App.Atoms.Keys.Count</SourceLine>
        <SourceLine>AtomsListBox.RemoveAllRows()</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
        <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomVersion As Double =  Atom.Value("Version")</SourceLine>
        <SourceLine>Var AtomAuthor As String =  Atom.Value("Author")</SourceLine>
        <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
        <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
        <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
        <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
        <SourceLine>Var AtomDate As String = AtomDateYear.ToString(Locale.Current, "0000") + "-" + AtomDateMonth.ToString(Locale.Current, "00")  + "-"  + AtomDateDay.ToString(Locale.Current, "00")</SourceLine>
        <SourceLine>Var AtomRepo As String = "Reactor"</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomStatus As String = "OK"</SourceLine>
        <SourceLine/>
        <SourceLine>If DateTime.Now.Year = AtomDateYear Then</SourceLine>
        <SourceLine>AtomStatus = "New"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
        <SourceLine>If AtomUpdated = True Then</SourceLine>
        <SourceLine>AtomStatus = "Update"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomDonation As String = "No"</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomVisible As Integer = 1</SourceLine>
        <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
        <SourceLine>Case 0</SourceLine>
        <SourceLine>// All</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Case 1</SourceLine>
        <SourceLine>// Installed</SourceLine>
        <SourceLine>If AtomInstalled(AtomID) = True Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 2</SourceLine>
        <SourceLine>// New</SourceLine>
        <SourceLine>If DateTime.Now.Year = AtomDateYear Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 3</SourceLine>
        <SourceLine>// Update</SourceLine>
        <SourceLine>If AtomUpdated = True Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine/>
        <SourceLine>If AtomVisible = 1 Then</SourceLine>
        <SourceLine>AtomsListBox.Addrow("")</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 1) = AtomName</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 2) = AtomCategory</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 3) = AtomVersion.ToString(Locale.Current, "0.0####")</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 4) = AtomAuthor</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 5) = AtomDate</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 6) = AtomRepo</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 7) = AtomStatus</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 8) = AtomDonation</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(AtomsListBox.LastAddedRowIndex, 9) = AtomID</SourceLine>
        <SourceLine>AtomsListBox.CellTagAt(AtomsListBox.LastAddedRowIndex, 0) = k</SourceLine>
        <SourceLine/>
        <SourceLine>// Is the atom installed already</SourceLine>
        <SourceLine>If AtomInstalled(AtomID) = True then</SourceLine>
        <SourceLine>AtomsListBox.CellCheckBoxStateAt(AtomsListBox.LastAddedRowIndex, 0) = DesktopCheckbox.VisualStates.Checked</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomsListBox.CellCheckBoxStateAt(AtomsListBox.LastAddedRowIndex, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>AtomsListBox.Sort</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>App.DownloadRow = -1</SourceLine>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>0</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams/>
      <ItemResult/>
    </Method>
