          <SourceLine>//MessageBox("Atom package download is done. The file is located here: " + file.NativePath)</SourceLine>
          <SourceLine/>
          <SourceLine>If App.DownloadRow &gt;= 0 Then</SourceLine>
          <SourceLine>AtomDeployFiles()</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>App.DownloadRow = -1</SourceLine>
          <SourceLine>App.DownloadAtomID = ""</SourceLine>
          <SourceLine>DownloadProgress.Value = 0</SourceLine>
          <SourceLine>DownloadProgress.Visible = False</SourceLine>
          <SourceLine>CancelButton.Visible = False</SourceLine>
          <SourceLine>//DownloadStatsLabel.Text = ""</SourceLine>
