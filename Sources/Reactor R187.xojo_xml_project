      <PartID>1056473087</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomsRefresh()</SourceLine>
        <SourceLine>Var SearchText As String = AtomSearchField.Text</SourceLine>
        <SourceLine/>
        <SourceLine>// Dependencies Check</SourceLine>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>App.DownloadDependencies().RemoveAll()</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>ExpandDependencies(Atom)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Atoms Refresh</SourceLine>
        <SourceLine>Var CategoryRow As Integer = CategoryListbox.SelectedRowIndex</SourceLine>
        <SourceLine>If CategoryRow &gt;= 0 Then</SourceLine>
        <SourceLine>Var SelectedCategory As String = CategoryListbox.CellTextAt(CategoryRow, 0)</SourceLine>
        <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
        <SourceLine>Var AtomCount As Integer = App.Atoms.Keys.Count</SourceLine>
        <SourceLine>AtomsListBox.RemoveAllRows()</SourceLine>
        <SourceLine/>
        <SourceLine>If SelectedCategory = "All" then</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
        <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomVersion As Double = Atom.Value("Version")</SourceLine>
        <SourceLine>Var AtomAuthor As String = Atom.Value("Author")</SourceLine>
        <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
        <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
        <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
        <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
        <SourceLine>Var AtomDate As String = AtomDateYear.ToString(Locale.Current, "0000") + "-" + AtomDateMonth.ToString(Locale.Current, "00")  + "-"  + AtomDateDay.ToString(Locale.Current, "00")</SourceLine>
        <SourceLine>Var AtomRepo As String = "Reactor"</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomDonation As String = "No"</SourceLine>
        <SourceLine>If Atom.HasKey("Donation") Then</SourceLine>
        <SourceLine>AtomDonation = "Yes"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomStatus As String = "OK"</SourceLine>
        <SourceLine>If DateTime.Now.Year = AtomDateYear Then</SourceLine>
        <SourceLine>AtomStatus = "New"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
        <SourceLine>If AtomUpdated = True Then</SourceLine>
        <SourceLine>AtomStatus = "Update"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomDisabled As Boolean = AtomIncompatible(AtomID)</SourceLine>
        <SourceLine>If AtomDisabled = True Then</SourceLine>
        <SourceLine>AtomStatus = "Incompatible"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomDownloading As Boolean = False</SourceLine>
        <SourceLine>If App.DownloadAtomID = AtomID Then</SourceLine>
        <SourceLine>AtomDownloading = True</SourceLine>
        <SourceLine>AtomStatus = "Downloading"</SourceLine>
        <SourceLine>'ElseIf App.DownloadDependencies.IndexOf(AtomID) &lt;&gt; -1 Then</SourceLine>
        <SourceLine>'// Atom Dependency</SourceLine>
        <SourceLine>'AtomDownloading = True</SourceLine>
        <SourceLine>'AtomStatus = "Downloading"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine>Var AtomVisible As Integer = 0</SourceLine>
        <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
        <SourceLine>Case 0</SourceLine>
        <SourceLine>// All</SourceLine>
        <SourceLine>if AtomDisabled = False Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 1</SourceLine>
        <SourceLine>// Installed</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 2</SourceLine>
        <SourceLine>// Donate</SourceLine>
        <SourceLine>If InstallState = True and Atom.HasKey("Donation") Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 3</SourceLine>
        <SourceLine>// New</SourceLine>
        <SourceLine>If DateTime.Now.Year = AtomDateYear and AtomDisabled = False Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 4</SourceLine>
        <SourceLine>// Update</SourceLine>
        <SourceLine>If AtomUpdated = True and AtomDisabled = False Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 5</SourceLine>
        <SourceLine>// Dependencies</SourceLine>
        <SourceLine>If App.DownloadDependencies.IndexOf(AtomID) &lt;&gt; -1 Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 6</SourceLine>
        <SourceLine>// Incompatible</SourceLine>
        <SourceLine>If AtomDisabled = True Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 7</SourceLine>
        <SourceLine>//Downloading</SourceLine>
        <SourceLine>If AtomDownloading = True and AtomDisabled = False Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Case 8</SourceLine>
        <SourceLine>// Removing</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine/>
        <SourceLine>// Apply search filter to AtomsListBox content</SourceLine>
        <SourceLine>If AtomVisible = 1 and SearchText &lt;&gt; "" Then</SourceLine>
        <SourceLine>// Check if any text exists in the search field</SourceLine>
        <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
        <SourceLine>If AtomName.Contains(SearchText) or AtomCategory.Contains(SearchText) or AtomAuthor.Contains(SearchText) or AtomID.Contains(SearchText) or TextDeployFilesList(Atom).Contains(SearchText) or AtomDescription.Contains(SearchText) Then</SourceLine>
        <SourceLine>AtomVisible = 1</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomVisible = 0</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If AtomVisible = 1 Then</SourceLine>
        <SourceLine>AtomsListBox.Addrow("")</SourceLine>
        <SourceLine>Var NewRow as Integer = AtomsListBox.LastAddedRowIndex</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 1) = AtomName</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 2) = AtomCategory</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 3) = AtomVersion.ToString(Locale.Current, "0.0####")</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 4) = AtomAuthor</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 5) = AtomDate</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 6) = AtomStatus</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 7) = AtomDonation</SourceLine>
        <SourceLine>AtomsListBox.CellTextAt(NewRow, 8) = AtomID</SourceLine>
        <SourceLine>AtomsListBox.CellTagAt(NewRow, 1) = k</SourceLine>
        <SourceLine/>
        <SourceLine>// Is the atom installed already / or is an update available?</SourceLine>
        <SourceLine>If InstallState = True Then</SourceLine>
        <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Checked</SourceLine>
        <SourceLine>ElseIf AtomUpdated = True Then</SourceLine>
        <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>AtomsListBox.CellCheckBoxStateAt(NewRow, 0) = AtomsListBox.CellTagAt(NewRow, 0)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
        <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
        <SourceLine>Var AtomCategoryArray() As String</SourceLine>
        <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
