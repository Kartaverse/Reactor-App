  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>AtomDownloadCancel</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>2142982143</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomDownloadCancel()</SourceLine>
   <SourceLine>// Cancel the download task</SourceLine>
   <SourceLine>RSocket.Disconnect()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If App.DownloadList.Count &gt;= 1 Then</SourceLine>
   <SourceLine>// Refresh the status displays</SourceLine>
   <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " Cancelled"</SourceLine>
   <SourceLine>DownloadProgress.Indeterminate = False</SourceLine>
   <SourceLine>DownloadProgress.Value = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Remove the partial file</SourceLine>
   <SourceLine>If App.DownloadFolderItem &lt;&gt; Nil And App.DownloadFolderItem.Exists then</SourceLine>
   <SourceLine>App.DownloadFolderItem.Remove()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.DownloadAtomID = ""</SourceLine>
   <SourceLine>App.DownloadName = ""</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>System.Debuglog("[Cancelled Download] " + App.DownloadFilename)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Purge the download queue</SourceLine>
   <SourceLine>For i As Integer = 0 to App.DownloadList.Count - 1</SourceLine>
   <SourceLine>App.DownloadList.Remove(i)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>App.DownloadList.Sort</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>AtomsRefresh()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
