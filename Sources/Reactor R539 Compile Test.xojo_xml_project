      <PartID>115787775</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function ScriptsUSBInputDevices() As Boolean</SourceLine>
        <SourceLine>If InputDeviceWindow.Visible = True Then</SourceLine>
        <SourceLine>// The Input Device window is currently open</SourceLine>
        <SourceLine>InputDeviceWindow.Hide()</SourceLine>
        <SourceLine>ElseIf InputDeviceWindow.Visible = False Then</SourceLine>
        <SourceLine>// The Input Device window is currently closed</SourceLine>
        <SourceLine>If App.GamepadSupport = 0 Then</SourceLine>
        <SourceLine>// USB support is decativated</SourceLine>
        <SourceLine>MessageBox("Please enable the ""USB and Bluetooth Gamepad Support"" option in the Reactor prefs before running this script.") </SourceLine>
        <SourceLine>ElseIf App.GamepadSupport = 1 Then</SourceLine>
        <SourceLine>// USB support is active</SourceLine>
        <SourceLine>InputDeviceWindow.Show()</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Return True</SourceLine>
        <SourceLine/>
        <SourceLine>End Function</SourceLine>
