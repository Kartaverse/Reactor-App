          <SourceLine>// If SelectedState = "Downloading" Then</SourceLine>
          <SourceLine>// Remove a completed download on the Downloading state view</SourceLine>
          <SourceLine>//AtomsListBox.RemoveRowAt(RefreshRow)</SourceLine>
          <SourceLine>// ElseIf SelectedState = "Not Installed" Then</SourceLine>
          <SourceLine>// Remove a completed download on the Uninstalled state view</SourceLine>
          <SourceLine>//AtomsListBox.RemoveRowAt(RefreshRow)</SourceLine>
          <SourceLine/>
          <SourceLine>// Else</SourceLine>
          <SourceLine>// Update a completed download on any other state view</SourceLine>
          <SourceLine>AtomsListBox.CellTextAt(RefreshRow, 6) = "Installed"</SourceLine>
