        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellBackground(g As Graphics, row As Integer, column As Integer) As Boolean</SourceLine>
          <SourceLine>// Clean out any previous cell content - Solves transparent icon drawing artifacts</SourceLine>
          <SourceLine>g.ClearRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Draw the listbox row shading</SourceLine>
          <SourceLine>// For ListBox multi-selection row shading look at "Me.Selected(row)"</SourceLine>
