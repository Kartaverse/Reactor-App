          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function MouseDown(x As Integer, y As Integer) As Boolean</SourceLine>
          <SourceLine>// Go to the next highlights page</SourceLine>
          <SourceLine>Var highBound As Integer = App.Highlights.Count</SourceLine>
          <SourceLine>Var Index As Integer = App.HighlightsIndex</SourceLine>
          <SourceLine/>
          <SourceLine>// Page flip to the right</SourceLine>
          <SourceLine>Index = Index + 1</SourceLine>
          <SourceLine/>
          <SourceLine>// Handle edge bounds looping</SourceLine>
          <SourceLine>If Index &gt; highBound Then</SourceLine>
          <SourceLine>Index = 1</SourceLine>
          <SourceLine>ElseIf Index &lt;= 0 Then</SourceLine>
          <SourceLine>Index = highBound</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Move to the next page</SourceLine>
          <SourceLine>RefreshHighlights(Index)</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
    </ControlBehavior>
