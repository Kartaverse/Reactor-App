        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellText(g as Graphics, row as Integer, column as Integer, x as Integer, y as Integer) As Boolean</SourceLine>
          <SourceLine>Select Case Me.CellTextAt(row, 6)</SourceLine>
          <SourceLine>Case "Not Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>Case "Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>Case "Downloading"</SourceLine>
          <SourceLine>// JustCropIt Cyan</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(119, 227, 252)</SourceLine>
          <SourceLine>Case "Queued"</SourceLine>
          <SourceLine>// JustCropIt Cyan</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(119, 227, 252)</SourceLine>
          <SourceLine>Case "Update"</SourceLine>
          <SourceLine>// JustCropIt Purple</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(193,135, 248)</SourceLine>
          <SourceLine>Case "New"</SourceLine>
          <SourceLine>// JustCropIt Neon Green</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(154, 233, 60)</SourceLine>
          <SourceLine>Case "Incompatible"</SourceLine>
          <SourceLine>// JustCropIt Neon Pink</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 60, 107)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Medium Grey Text</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(151, 151, 151)</SourceLine>
          <SourceLine>End Select</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Custom Checkbox</SourceLine>
          <SourceLine>If column = 0 Then</SourceLine>
          <SourceLine>// Clean out any previous cell content - Solves transparent icon drawing artifacts</SourceLine>
          <SourceLine>g.ClearRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>Var iconY as Integer = (g.Height - CheckboxOn.Height) / 2</SourceLine>
          <SourceLine>If Me.CellTagAt(row, 0) = "Installed" Then</SourceLine>
          <SourceLine>// Installed</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOn, 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Not Installed" Then</SourceLine>
          <SourceLine>// Uninstalled</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOff, 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Queued" Then</SourceLine>
          <SourceLine>// Downloading/Queued</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxInProgress, 0, iconY)</SourceLine>
          <SourceLine>ElseIf Me.CellTagAt(row, 0) = "Downloading" Then</SourceLine>
          <SourceLine>// Downloading/Queued</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxDownloading, 0, iconY)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Fallback to unchecked</SourceLine>
          <SourceLine>g.DrawPicture(CheckboxOff, 0, iconY)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
