        <SourceLine/>
        <SourceLine/>
        <SourceLine>// Deploy files</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>Var DeployCount As Integer = AtomDeploy.Keys.Count</SourceLine>
        <SourceLine>System.Debuglog("[Deploy File Count] " + DeployCount.ToString())</SourceLine>
        <SourceLine>// MessageBox(VarType(AtomDeploy).ToString)</SourceLine>
        <SourceLine>// Type 9 = Object</SourceLine>
        <SourceLine>If AtomDeploy.Keys &lt;&gt; Nil Then</SourceLine>
        <SourceLine>For Each k As String In AtomDeploy.Keys</SourceLine>
        <SourceLine>// Todo: Handle OS-Secific deploy files</SourceLine>
        <SourceLine>if k &lt;&gt; "Mac" and k &lt;&gt; "Windows" and k &lt;&gt; "Linux" Then</SourceLine>
        <SourceLine>// Common Files</SourceLine>
