    <HookInstance>
      <ItemName>Opening</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1196244991</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Opening()</SourceLine>
        <SourceLine>// Turn the download queue off</SourceLine>
        <SourceLine>ReactorWindow.QueueTimer.RunMode = Timer.RunModes.Off</SourceLine>
        <SourceLine>ReactorWindow.AtomDownloadCancel()</SourceLine>
        <SourceLine/>
        <SourceLine>// Window sizing</SourceLine>
        <SourceLine>If ReactorWindow.Visible = True Then</SourceLine>
        <SourceLine>Me.Top = DesktopDisplay.DisplayAt(0).AvailableTop + 28 + (ReactorWindow.Height / 2) - (Me.Height / 2)</SourceLine>
        <SourceLine>Me.Left = ReactorWindow.Left + (ReactorWindow.Width / 2) - (Me.Width / 2)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Gamepad support</SourceLine>
        <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
        <SourceLine>Self.GamepadSupportCheckBox.VisualState = DesktopCheckBox.VisualStates.Checked</SourceLine>
        <SourceLine>ElseIf App.GamepadSupport = 0 Then</SourceLine>
        <SourceLine>Self.GamepadSupportCheckBox.VisualState = DesktopCheckBox.VisualStates.Unchecked</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Search</SourceLine>
        <SourceLine>If App.LiveSearch = True Then</SourceLine>
        <SourceLine>Self.LiveSearchCheckbox.VisualState = DesktopCheckBox.VisualStates.Checked</SourceLine>
        <SourceLine>ElseIf App.LiveSearch = True Then</SourceLine>
        <SourceLine>Self.LiveSearchCheckbox.VisualState = DesktopCheckBox.VisualStates.Unchecked</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
