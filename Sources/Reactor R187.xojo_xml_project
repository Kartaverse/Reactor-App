      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomURL(AtomID As String)</SourceLine>
        <SourceLine>// This method supports the Reactor:/&lt;AtomID&gt; website URL syntax</SourceLine>
        <SourceLine>// Clicking a Reactor weblink in a web browswer causes the Reactor app</SourceLine>
        <SourceLine>// to navigate to the selected atom package in the AtomsListBox view</SourceLine>
        <SourceLine/>
        <SourceLine>If AtomID &lt;&gt; "" Then</SourceLine>
        <SourceLine>Var row As Integer</SourceLine>
        <SourceLine>For row = 0 To CategoryListBox.LastRowIndex</SourceLine>
        <SourceLine>If CategoryListBox.CellTextAt(row, 0) = "All" Then </SourceLine>
        <SourceLine>CategoryListBox.SelectedRowIndex = row</SourceLine>
        <SourceLine>CategoryListBox.SetFocus</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine/>
        <SourceLine>For row = 0 To AtomsListBox.LastRowIndex</SourceLine>
        <SourceLine>If AtomsListBox.CellTextAt(row, 8) = AtomID Then </SourceLine>
        <SourceLine>AtomsListBox.SelectedRowIndex = row</SourceLine>
        <SourceLine>AtomsListBox.SetFocus</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>End if</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
