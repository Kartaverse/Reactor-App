          <SourceLine>System.Debuglog("[Downloaded Package] " + file.NativePath)</SourceLine>
          <SourceLine>//MessageBox("Atom package download is done. The file is located here: " + file.NativePath)</SourceLine>
          <SourceLine/>
          <SourceLine>If App.DownloadRow &gt;= 0 Then</SourceLine>
          <SourceLine>AtomDeploy()</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>App.DownloadRow = -1</SourceLine>
          <SourceLine>DownloadProgress.Value = 0</SourceLine>
          <SourceLine>DownloadProgress.Visible = False</SourceLine>
          <SourceLine>CancelButton.Visible = False</SourceLine>
          <SourceLine>//DownloadStatsLabel.Text = ""</SourceLine>
          <SourceLine/>
          <SourceLine>// The Reactor app was quit with the CancelClosing "Complete Downloads, Then Quit" option.</SourceLine>
          <SourceLine>If App.QuitOnDownloadComplete = 1 Then</SourceLine>
          <SourceLine>App.QuitAllowed = 1</SourceLine>
          <SourceLine>Quit()</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
