 <Method>
  <ItemName>Download</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>6021119</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Download(url As String, path As FolderItem)</SourceLine>
   <SourceLine>// Get filename from URL</SourceLine>
   <SourceLine>Var filenameLength As Integer</SourceLine>
   <SourceLine>For i As Integer = url.Length - 1 DownTo 0</SourceLine>
   <SourceLine>If url.Middle(i, 1) = "/" Then</SourceLine>
   <SourceLine>filenameLength = url.Length - i</SourceLine>
   <SourceLine>Exit For</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Var filename As String</SourceLine>
   <SourceLine>filename = url.Right(filenameLength).ReplaceAll("/", "")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var downloadFile As FolderItem = path</SourceLine>
   <SourceLine>App.DownloadFilename = downloadFile.Name</SourceLine>
   <SourceLine>App.DownloadFolderItem = downloadFile</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Download the file</SourceLine>
   <SourceLine>RSocket.Send("GET", url, downloadFile)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>url As String, path As FolderItem</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>CategoryRefresh</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1107865599</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub CategoryRefresh()</SourceLine>
   <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>CategoryListBox.RemoveAllRows()</SourceLine>
   <SourceLine>CategoryListBox.AddExpandableRow( "All")</SourceLine>
   <SourceLine>CategoryListBox.RowTagAt(CategoryListBox.LastAddedRowIndex) = "All"</SourceLine>
   <SourceLine>CategoryListBox.RowExpandableAt(0) = False </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var Depth As Integer = 0</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
   <SourceLine>Var AtomCategoryArray() As String</SourceLine>
   <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Depth &lt;= AtomCategoryArray.Count - 1 then</SourceLine>
   <SourceLine>If Depth = 0 then</SourceLine>
   <SourceLine>// Scan through the Category segments</SourceLine>
   <SourceLine>Var ExcludeItem as Boolean = False</SourceLine>
   <SourceLine>Var row As Integer</SourceLine>
   <SourceLine>For row = 0 To CategoryListBox.LastRowIndex</SourceLine>
   <SourceLine>If Depth = CategoryListBox.RowDepthAt(row) - 1 And CategoryListBox.CellTextAt(row) = AtomCategoryArray(Depth) Then </SourceLine>
   <SourceLine>ExcludeItem = True</SourceLine>
   <SourceLine>Exit For row // or Return if inside method</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Not ExcludeItem then</SourceLine>
   <SourceLine>CategoryListBox.AddRowAt(CategoryListBox.LastAddedRowIndex, AtomCategoryArray(Depth), Depth + 1)</SourceLine>
   <SourceLine>CategoryListBox.CellTextAt(CategoryListBox.LastAddedRowIndex) = AtomCategoryArray(Depth)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>CategoryListBox.Sort</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reset the category selection to All</SourceLine>
   <SourceLine>If CategoryListbox.RowCount &gt;= 1 Then</SourceLine>
   <SourceLine>CategoryListbox.SelectedRowIndex = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>AtomsRefresh</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1056473087</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomsRefresh()</SourceLine>
   <SourceLine>Var SearchText As String = AtomSearchField.Text</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Output the number content as English-US for the CLI</SourceLine>
   <SourceLine>Var currentLocale As Locale = Locale.Current</SourceLine>
   <SourceLine>Var USEnglishLocale As New Locale("en-US")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Dependencies Check</SourceLine>
   <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>App.DependencyList().RemoveAll()</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>ExpandDependencies(Atom)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Atoms Refresh</SourceLine>
   <SourceLine>Var CategoryRow As Integer = CategoryListbox.SelectedRowIndex</SourceLine>
   <SourceLine>If CategoryRow &gt;= 0 Then</SourceLine>
   <SourceLine>Var SelectedCategory As String = CategoryListbox.CellTextAt(CategoryRow, 0)</SourceLine>
   <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>Var AtomCount As Integer = App.Atoms.Keys.Count</SourceLine>
   <SourceLine>AtomsListBox.RemoveAllRows()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If SelectedCategory = "All" then</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
   <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
   <SourceLine>Var AtomVersion As Double = Atom.Value("Version")</SourceLine>
   <SourceLine>Var AtomAuthor As String = Atom.Value("Author")</SourceLine>
   <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
   <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
   <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
   <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
   <SourceLine>Var AtomDate As String = AtomDateYear.ToString(Locale.Current, "0000") + "-" + AtomDateMonth.ToString(Locale.Current, "00")  + "-"  + AtomDateDay.ToString(Locale.Current, "00")</SourceLine>
   <SourceLine>Var AtomRepo As String = "Reactor"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomDonation As String = "No"</SourceLine>
   <SourceLine>If Atom.HasKey("Donation") Then</SourceLine>
   <SourceLine>AtomDonation = "Yes"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomStatus As String = "OK"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Calculate if the atom is "New" </SourceLine>
   <SourceLine>Var AtomDateTime As New DateTime(AtomDateYear, AtomDateMonth, AtomDateDay)</SourceLine>
   <SourceLine>Var NowDateTime As DateTime = DateTime.Now</SourceLine>
   <SourceLine>// How many days ago was the atom posted in Reactor?</SourceLine>
   <SourceLine>Var DaysElapsed As Integer = (NowDateTime.SecondsFrom1970 - AtomDateTime.SecondsFrom1970) / (24 * 60 * 60)</SourceLine>
   <SourceLine>// Number of days an atom is marked as new</SourceLine>
   <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
   <SourceLine>AtomStatus = "New"</SourceLine>
   <SourceLine>// System.DebugLog(AtomID + " [Date] " + AtomDate + " [Days Elapsed] " + DaysElapsed.ToString)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
   <SourceLine>If AtomUpdated = True Then</SourceLine>
   <SourceLine>AtomStatus = "Update"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomDisabled As Boolean = AtomIncompatible(AtomID)</SourceLine>
   <SourceLine>If AtomDisabled = True Then</SourceLine>
   <SourceLine>AtomStatus = "Incompatible"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
   <SourceLine>Var AtomDownloading As Boolean = False</SourceLine>
   <SourceLine>If App.DownloadAtomID = AtomID Then</SourceLine>
   <SourceLine>AtomDownloading = True</SourceLine>
   <SourceLine>AtomStatus = "Downloading"</SourceLine>
   <SourceLine>ElseIf App.DownloadList.IndexOf(AtomID) &lt;&gt; -1 and InstallState = False Then</SourceLine>
   <SourceLine>AtomDownloading = True</SourceLine>
   <SourceLine>AtomStatus = "Queued"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomVisible As Integer = 0</SourceLine>
   <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>// All</SourceLine>
   <SourceLine>if AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>// Update</SourceLine>
   <SourceLine>If AtomUpdated = True and AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>// Installed</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 3</SourceLine>
   <SourceLine>// Uninstalled</SourceLine>
   <SourceLine>If InstallState = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 4</SourceLine>
   <SourceLine>// Donate</SourceLine>
   <SourceLine>If InstallState = True and Atom.HasKey("Donation") Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 5</SourceLine>
   <SourceLine>// New</SourceLine>
   <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 6</SourceLine>
   <SourceLine>// Dependencies</SourceLine>
   <SourceLine>If App.DependencyList.IndexOf(AtomID) &lt;&gt; -1 Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 7</SourceLine>
   <SourceLine>// Incompatible</SourceLine>
   <SourceLine>If AtomDisabled = True Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 8</SourceLine>
   <SourceLine>// Downloading</SourceLine>
   <SourceLine>If AtomDownloading = True and AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Apply search filter to AtomsListBox content</SourceLine>
   <SourceLine>If AtomVisible = 1 and SearchText &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Check if any text exists in the search field</SourceLine>
   <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
   <SourceLine>If AtomName.Contains(SearchText) or AtomCategory.Contains(SearchText) or AtomAuthor.Contains(SearchText) or AtomID.Contains(SearchText) or TextDeployFilesList(Atom).Contains(SearchText) or AtomDescription.Contains(SearchText) Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If AtomVisible = 1 Then</SourceLine>
   <SourceLine>AtomsListBox.Addrow("")</SourceLine>
   <SourceLine>Var NewRow as Integer = AtomsListBox.LastAddedRowIndex</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 1) = AtomName</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 2) = AtomCategory</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 3) = AtomVersion.ToString(USEnglishLocale, "0.0####")</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 4) = AtomAuthor</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 5) = AtomDate</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 6) = AtomStatus</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 7) = AtomDonation</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 8) = AtomID</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 1) = k</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Is the atom installed already / or is an update available?</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Checked</SourceLine>
   <SourceLine>ElseIf AtomUpdated = True or AtomDownloading = True Then</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>AtomsListBox.CellCheckBoxStateAt(NewRow, 0) = AtomsListBox.CellTagAt(NewRow, 0)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
   <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
   <SourceLine>Var AtomCategoryArray() As String</SourceLine>
   <SourceLine>AtomCategoryArray = AtomCategory.Split("/")</SourceLine>
   <SourceLine>if AtomCategoryArray(0) = SelectedCategory Then</SourceLine>
   <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
   <SourceLine>Var AtomVersion As Double =  Atom.Value("Version")</SourceLine>
   <SourceLine>Var AtomAuthor As String =  Atom.Value("Author")</SourceLine>
   <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
   <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
   <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
   <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
   <SourceLine>Var AtomDate As String = AtomDateYear.ToString(USEnglishLocale, "0000") + "-" + AtomDateMonth.ToString(USEnglishLocale, "00")  + "-"  + AtomDateDay.ToString(USEnglishLocale, "00")</SourceLine>
   <SourceLine>Var AtomRepo As String = "Reactor"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomDonation As String = "No"</SourceLine>
   <SourceLine>If Atom.HasKey("Donation") Then</SourceLine>
   <SourceLine>AtomDonation = "Yes"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomStatus As String = "OK"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Calculate if the atom is "New" </SourceLine>
   <SourceLine>Var AtomDateTime As New DateTime(AtomDateYear, AtomDateMonth, AtomDateDay)</SourceLine>
   <SourceLine>Var NowDateTime As DateTime = DateTime.Now</SourceLine>
   <SourceLine>// How many days ago was the atom posted in Reactor?</SourceLine>
   <SourceLine>Var DaysElapsed As Integer = (NowDateTime.SecondsFrom1970 - AtomDateTime.SecondsFrom1970) / (24 * 60 * 60)</SourceLine>
   <SourceLine>// Number of days an atom is marked as new</SourceLine>
   <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
   <SourceLine>AtomStatus = "New"</SourceLine>
   <SourceLine>// System.DebugLog(AtomID + " [Date] " + AtomDate + " [Days Elapsed] " + DaysElapsed.ToString)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomUpdated As Boolean = AtomUpdateAvailable(AtomID)</SourceLine>
   <SourceLine>If AtomUpdated = True Then</SourceLine>
   <SourceLine>AtomStatus = "Update"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomDisabled As Boolean = AtomIncompatible(AtomID)</SourceLine>
   <SourceLine>If AtomDisabled = True Then</SourceLine>
   <SourceLine>AtomStatus = "Incompatible"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
   <SourceLine>Var AtomDownloading As Boolean = False</SourceLine>
   <SourceLine>If App.DownloadAtomID = AtomID Then</SourceLine>
   <SourceLine>AtomDownloading = True</SourceLine>
   <SourceLine>AtomStatus = "Downloading"</SourceLine>
   <SourceLine>ElseIf App.DownloadList.IndexOf(AtomID) &lt;&gt; -1 and InstallState = False Then</SourceLine>
   <SourceLine>AtomDownloading = True</SourceLine>
   <SourceLine>AtomStatus = "Queued"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomVisible As Integer = 0</SourceLine>
   <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>// All</SourceLine>
   <SourceLine>if AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>// Update</SourceLine>
   <SourceLine>If AtomUpdated = True and AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>// Installed</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 3</SourceLine>
   <SourceLine>// Uninstalled</SourceLine>
   <SourceLine>If InstallState = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 4</SourceLine>
   <SourceLine>// Donate</SourceLine>
   <SourceLine>If InstallState = True and Atom.HasKey("Donation") Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 5</SourceLine>
   <SourceLine>// New</SourceLine>
   <SourceLine>If App.MarkAsNew = True and App.NewForDays &gt;= DaysElapsed Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 6</SourceLine>
   <SourceLine>// Dependencies</SourceLine>
   <SourceLine>If App.DependencyList.IndexOf(AtomID) &lt;&gt; -1 Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 7</SourceLine>
   <SourceLine>// Incompatible</SourceLine>
   <SourceLine>If AtomDisabled = True Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 8</SourceLine>
   <SourceLine>// Downloading</SourceLine>
   <SourceLine>If AtomDownloading = True and AtomDisabled = False Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Apply search filter to AtomsListBox content</SourceLine>
   <SourceLine>If AtomVisible = 1 and SearchText &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Check if any text exists in the search field</SourceLine>
   <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
   <SourceLine>If AtomName.Contains(SearchText) or AtomCategory.Contains(SearchText) or AtomAuthor.Contains(SearchText) or AtomID.Contains(SearchText) or TextDeployFilesList(Atom).Contains(SearchText) or AtomDescription.Contains(SearchText) Then</SourceLine>
   <SourceLine>AtomVisible = 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomVisible = 0</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If AtomVisible = 1 Then</SourceLine>
   <SourceLine>AtomsListBox.Addrow("")</SourceLine>
   <SourceLine>Var NewRow as Integer = AtomsListBox.LastAddedRowIndex</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 1) = AtomName</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 2) = AtomCategory</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 3) = AtomVersion.ToString(USEnglishLocale, "0.0####")</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 4) = AtomAuthor</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 5) = AtomDate</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 6) = AtomStatus</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 7) = AtomDonation</SourceLine>
   <SourceLine>AtomsListBox.CellTextAt(NewRow, 8) = AtomID</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 1) = k</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Is the atom installed already / or is an update available?</SourceLine>
   <SourceLine>If InstallState = True Then</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Checked</SourceLine>
   <SourceLine>ElseIf AtomUpdated = True or AtomDownloading = True Then</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomsListBox.CellTagAt(NewRow, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>AtomsListBox.CellCheckBoxStateAt(NewRow, 0) = AtomsListBox.CellTagAt(NewRow, 0)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>AtomsListBox.Sort</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// List the package totals in the Window titlebar</SourceLine>
   <SourceLine>Var SelectedCategory As String = RepoPopupMenu.SelectedRowText</SourceLine>
   <SourceLine>Var FilteredAtomCount As Integer = AtomsListBox.RowCount</SourceLine>
   <SourceLine>If SelectedCategory = "All" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Installed" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " Installed Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Uninstalled" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " Uninstalled Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "New" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " New Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Update" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager -  " + FilteredAtomCount.ToString + " Updated Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Donate" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager -  " + FilteredAtomCount.ToString + " Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Dependencies" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " Required Packages"</SourceLine>
   <SourceLine>ElseIf SelectedCategory = "Downloading" then</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager - " + FilteredAtomCount.ToString + " Packages"</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>ReactorWindow.Title = "Reactor Package Manager"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
