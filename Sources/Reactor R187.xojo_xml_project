    <HookInstance>
      <ItemName>CancelClosing</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>254601215</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function CancelClosing() As Boolean</SourceLine>
        <SourceLine>// The cancelClosing event is called when the app receives the quit signal</SourceLine>
        <SourceLine>If App.DownloadRow &gt;= 0 and App.QuitAllowed = 0 Then</SourceLine>
        <SourceLine>Var Quit_Message_Dialog As New MessageDialog                        // Create the MessageDialog object</SourceLine>
        <SourceLine>Quit_Message_Dialog.IconType = MessageDialog.IconTypes.Caution // Display warning icon</SourceLine>
        <SourceLine>Quit_Message_Dialog.ActionButton.Caption = "Quit"</SourceLine>
        <SourceLine>Quit_Message_Dialog.CancelButton.Visible = True                        // Show the Cancel button</SourceLine>
        <SourceLine>//Quit_Message_Dialog.AlternateActionButton.Visible = True       // Show the alternate action button</SourceLine>
        <SourceLine>//Quit_Message_Dialog.AlternateActionButton.Caption = "Complete Downloads, Then Quit"</SourceLine>
        <SourceLine>Quit_Message_Dialog.Message = "Do you want to quit Reactor?"</SourceLine>
        <SourceLine>Quit_Message_Dialog.Explanation = "A download is still in progress."</SourceLine>
        <SourceLine/>
        <SourceLine>Var Quit_Message_Dialog_Button As MessageDialogButton                 // For handling the result</SourceLine>
        <SourceLine>Quit_Message_Dialog_Button = Quit_Message_Dialog.ShowModal  // Display the dialog</SourceLine>
        <SourceLine>Select Case Quit_Message_Dialog_Button              // Determine which button was pressed.</SourceLine>
        <SourceLine>Case Quit_Message_Dialog.ActionButton</SourceLine>
        <SourceLine>// User pressed "Quit"</SourceLine>
        <SourceLine>// Go ahead and quit the program</SourceLine>
        <SourceLine>ReactorWindow.AtomDownloadCancel()</SourceLine>
        <SourceLine>Return False</SourceLine>
        <SourceLine>Case Quit_Message_Dialog.AlternateActionButton</SourceLine>
        <SourceLine>// User pressed "Complete Downloads, Then Quit</SourceLine>
        <SourceLine>// Do something with a deferred RSocket event handler</SourceLine>
        <SourceLine>App.QuitOnDownloadComplete = 1</SourceLine>
        <SourceLine>Return True</SourceLine>
        <SourceLine>Case Quit_Message_Dialog.CancelButton</SourceLine>
        <SourceLine>// User pressed "Cancel"</SourceLine>
        <SourceLine>// Cancel the quit event and let the program continue running</SourceLine>
        <SourceLine/>
        <SourceLine>Return True</SourceLine>
        <SourceLine>End Select</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Function</SourceLine>
      </ItemSource>
    </HookInstance>
    <HookInstance>
      <ItemName>AppleEventReceived</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>2054318079</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function AppleEventReceived(theEvent As AppleEvent, eventClass As String, eventID As String) As Boolean</SourceLine>
        <SourceLine>If eventClass = "GURL" Then</SourceLine>
        <SourceLine>// YouTube: Usa URI personalizados en tus Apps Xojo</SourceLine>
        <SourceLine>// https://www.youtube.com/watch?v=N-WLwbfp7Nw</SourceLine>
        <SourceLine>// https://blog.xojo.com/2016/05/09/let-your-os-x-desktop-app-react-to-custom-uris/</SourceLine>
        <SourceLine/>
        <SourceLine>// The string.ReplaceAll("/", "") function strips out the URL slashes from a string like "reactor://" to make it "reactor:"</SourceLine>
        <SourceLine>Var url() as string = DecodeURLComponent(theEvent.StringParam("----")).DefineEncoding(encodings.UTF8).ReplaceAll("/", "").Split(":")</SourceLine>
        <SourceLine>url.Remove(0)</SourceLine>
        <SourceLine/>
        <SourceLine>Var Tokens As String = join(url, ":")</SourceLine>
        <SourceLine/>
        <SourceLine>// Remove ".atom" from the end of the string</SourceLine>
        <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.atom</SourceLine>
        <SourceLine>Var regex As New RegEx</SourceLine>
        <SourceLine>regex.SearchPattern = "[.]atom$"  // Matches the end of the string</SourceLine>
        <SourceLine>regex.ReplacementPattern = ""</SourceLine>
        <SourceLine>Tokens = regex.Replace(Tokens)</SourceLine>
        <SourceLine/>
        <SourceLine>// Remove ".zip" from the end of the string</SourceLine>
        <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.zip</SourceLine>
        <SourceLine>regex.SearchPattern = "[.]zip$"  // Matches the end of the string</SourceLine>
        <SourceLine>regex.ReplacementPattern = ""</SourceLine>
        <SourceLine>Tokens = regex.Replace(Tokens)</SourceLine>
        <SourceLine/>
        <SourceLine>// Split the tokens</SourceLine>
        <SourceLine>Var csvArray() As String = Tokens.Split(",")</SourceLine>
        <SourceLine>ReactorWindow.DownloadStatsLabel.Text = Tokens</SourceLine>
        <SourceLine>System.Debuglog("[Reactor URL] """ + Tokens + """")</SourceLine>
        <SourceLine/>
        <SourceLine>// Navigate to the atom package</SourceLine>
        <SourceLine>// Var AtomID As String = csvArray(0)</SourceLine>
        <SourceLine>Var AtomID As String = Tokens</SourceLine>
        <SourceLine>ReactorWindow.AtomURL(AtomID)</SourceLine>
        <SourceLine/>
        <SourceLine>// Enter the atom package name into the search field</SourceLine>
        <SourceLine>// ReactorWindow.SearchTextField.Text = AtomID</SourceLine>
        <SourceLine>// ReactorWindow.SearchButton.Press()</SourceLine>
        <SourceLine/>
        <SourceLine>Return True</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Return False</SourceLine>
        <SourceLine/>
        <SourceLine>End Function</SourceLine>
      </ItemSource>
    </HookInstance>
