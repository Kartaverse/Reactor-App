 <HookInstance>
  <ItemName>AppleEventReceived</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>2054318079</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AppleEventReceived(theEvent As AppleEvent, eventClass As String, eventID As String) As Boolean</SourceLine>
   <SourceLine>If eventClass = "GURL" Then</SourceLine>
   <SourceLine>// YouTube: Usa URI personalizados en tus Apps Xojo</SourceLine>
   <SourceLine>// https://www.youtube.com/watch?v=N-WLwbfp7Nw</SourceLine>
   <SourceLine>// https://blog.xojo.com/2016/05/09/let-your-os-x-desktop-app-react-to-custom-uris/</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// The string.ReplaceAll("/", "") function strips out the URL slashes from a string like "reactor://" to make it "reactor:"</SourceLine>
   <SourceLine>Var url() as string = DecodeURLComponent(theEvent.StringParam("----")).DefineEncoding(encodings.UTF8).ReplaceAll("/", "").Split(":")</SourceLine>
   <SourceLine>url.Remove(0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var Tokens As String = join(url, ":")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Remove ".atom" from the end of the string</SourceLine>
   <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.atom</SourceLine>
   <SourceLine>Var regex As New RegEx</SourceLine>
   <SourceLine>regex.SearchPattern = "[.]atom$"  // Matches the end of the string</SourceLine>
   <SourceLine>regex.ReplacementPattern = ""</SourceLine>
   <SourceLine>Tokens = regex.Replace(Tokens)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Remove ".zip" from the end of the string</SourceLine>
   <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.zip</SourceLine>
   <SourceLine>regex.SearchPattern = "[.]zip$"  // Matches the end of the string</SourceLine>
   <SourceLine>regex.ReplacementPattern = ""</SourceLine>
   <SourceLine>Tokens = regex.Replace(Tokens)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Split the tokens</SourceLine>
   <SourceLine>Var csvArray() As String = Tokens.Split(",")</SourceLine>
   <SourceLine>ReactorWindow.DownloadStatsLabel.Text = Tokens</SourceLine>
   <SourceLine>System.Debuglog("[Reactor URL] """ + Tokens + """")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Navigate to the atom package</SourceLine>
   <SourceLine>// Var AtomID As String = csvArray(0)</SourceLine>
   <SourceLine>Var AtomID As String = Tokens</SourceLine>
   <SourceLine>ReactorWindow.AtomURL(AtomID)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Enter the atom package name into the search field</SourceLine>
   <SourceLine>// ReactorWindow.SearchTextField.Text = AtomID</SourceLine>
   <SourceLine>// ReactorWindow.SearchButton.Press()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
 </HookInstance>
