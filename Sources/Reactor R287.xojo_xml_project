 <Method>
  <ItemName>AtomDeployFiles</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>21618687</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomDeployFiles()</SourceLine>
   <SourceLine>// UnZip the downloaded atomz package</SourceLine>
   <SourceLine>If App.DownloadFolderItem &lt;&gt; Nil and App.DownloadFolderItem.exists Then</SourceLine>
   <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
   <SourceLine>App.CreateReactorFolders()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Expand the archive</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.DownloadFolderItem.Unzip(App.TemporaryAtomFolder)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Build the GitLab expanded folder name on disk</SourceLine>
   <SourceLine>// Reactor-master-Atoms-com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// This string still has the zip file extension</SourceLine>
   <SourceLine>Var FolderName As String = App.DownloadFilename</SourceLine>
   <SourceLine>If FolderName &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Remove ".zip" from the end of the string</SourceLine>
   <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.zip</SourceLine>
   <SourceLine>Var regex As New RegEx</SourceLine>
   <SourceLine>regex.SearchPattern = "[.]zip$"  // Matches the end of the string</SourceLine>
   <SourceLine>regex.ReplacementPattern = ""</SourceLine>
   <SourceLine>FolderName = regex.Replace(FolderName)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Zip File Prefix</SourceLine>
   <SourceLine>Var ZipFilePrefix As String = ""</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("Repos") Then</SourceLine>
   <SourceLine>Var jsonRepos As JSONItem = App.Settings.Value("Repos")</SourceLine>
   <SourceLine>If jsonRepos.HasKey("_Core") Then</SourceLine>
   <SourceLine>Var jsonReposCore As JSONItem =  jsonRepos.Value("_Core")</SourceLine>
   <SourceLine>If jsonReposCore.HasKey("ZIPFilePrefix") Then</SourceLine>
   <SourceLine>ZipFilePrefix = jsonReposCore.Value("ZIPFilePrefix")</SourceLine>
   <SourceLine>// MessageBox(ZipFilePrefix)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>// Fallback file name</SourceLine>
   <SourceLine>If ZipFilePrefix = "" Then</SourceLine>
   <SourceLine>ZipFilePrefix = "Reactor-master-Atoms-"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// This temp sub-folder where the deploy files need to be sourced from when moving the files to the final install location</SourceLine>
   <SourceLine>Var WorkingDirectory As FolderItem = App.TemporaryAtomFolder.Child(ZipFilePrefix + FolderName).Child("Atoms").Child(FolderName)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Extract a single JSON encoded Atom package defintion</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.DownloadAtom</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
   <SourceLine>Var AtomDeploy As JSONItem = Atom.Value("Deploy")</SourceLine>
   <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
   <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var options As New JSONOptions</SourceLine>
   <SourceLine>options.Compact = False</SourceLine>
   <SourceLine>options.IndentSpacing = 4</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.DownloadAtomID = AtomID</SourceLine>
   <SourceLine>App.DownloadName = AtomName</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// com.AndrewHazelden.KartaLink.Scripts.SpatialMetadata.json</SourceLine>
   <SourceLine>Var JSONAtomFile As FolderItem = WorkingDirectory.Child(AtomID + ".json")</SourceLine>
   <SourceLine>Var LuaTableAtomFile As FolderItem = WorkingDirectory.Child(AtomID + ".atom")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Write the JSON file to disk</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>Var tos As TextOutputStream</SourceLine>
   <SourceLine>If JSONAtomFile &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos = TextOutputStream.Create(JSONAtomFile)</SourceLine>
   <SourceLine>If tos &lt;&gt; Nil and Atom &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos.Write(Atom.ToString(options))</SourceLine>
   <SourceLine>tos.Close</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Debug: Open the newly saved JSON encoded atom in the default editor</SourceLine>
   <SourceLine>// JSONAtomFile.Launch</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Debug: Reveal the working directory in a folder browsing window</SourceLine>
   <SourceLine>// WorkingDirectory.Launch</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Debug: Print the atom package deploy files</SourceLine>
   <SourceLine>// System.Debuglog("[Deploy]\n" + AtomDeploy.ToString(options))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Move the .atom and .json files to the Deploy folder</SourceLine>
   <SourceLine>Var DestFile As FolderItem</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// JSON</SourceLine>
   <SourceLine>DestFile = App.DeployJSONReactorFolder.Child(JSONAtomFile.Name)</SourceLine>
   <SourceLine>If DestFile.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DestFile.Remove()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If JSONAtomFile.Exists Then</SourceLine>
   <SourceLine>// Install the new file</SourceLine>
   <SourceLine>JSONAtomFile.CopyTo(App.DeployJSONReactorFolder)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Atom</SourceLine>
   <SourceLine>DestFile = App.AtomsReactorFolder.Child(LuaTableAtomFile.Name)</SourceLine>
   <SourceLine>If DestFile.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DestFile.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>DestFile = App.DeployAtomsReactorFolder.Child(LuaTableAtomFile.Name)</SourceLine>
   <SourceLine>If DestFile.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DestFile.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>if LuaTableAtomFile.exists Then</SourceLine>
   <SourceLine>// Install the new file</SourceLine>
   <SourceLine>LuaTableAtomFile.CopyTo(App.AtomsReactorFolder)</SourceLine>
   <SourceLine>LuaTableAtomFile.CopyTo(App.DeployAtomsReactorFolder)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Deploy files</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If AtomDeploy.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As String In AtomDeploy.Keys</SourceLine>
   <SourceLine>if k &lt;&gt; "Mac" and k &lt;&gt; "Windows" and k &lt;&gt; "Linux" Then</SourceLine>
   <SourceLine>// Common Files</SourceLine>
   <SourceLine>Var DeployVariant As Variant = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>Var DeployFileSource As FolderItem =  New FolderItem(WorkingDirectory.NativePath + "/" + DeployVariant.StringValue)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>If not DeployFileDest.Parent.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Create Folders] " + DeployFileDest.Parent.NativePath)</SourceLine>
   <SourceLine>ReactorWindow.CreateParentSubFolders(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Read File] " + DeployFileSource.NativePath)</SourceLine>
   <SourceLine>System.Debuglog("[Write File] " + DeployFileDest.NativePath)</SourceLine>
   <SourceLine>DeployFileSource.CopyTo(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>ElseIf k = "Mac" and TargetMacOS Then</SourceLine>
   <SourceLine>// macOS Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileSource As FolderItem =  New FolderItem(WorkingDirectory.NativePath + "/Mac/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>If not DeployFileDest.Parent.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Create Folders] " + DeployFileDest.Parent.NativePath)</SourceLine>
   <SourceLine>ReactorWindow.CreateParentSubFolders(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Read File] " + DeployFileSource.NativePath)</SourceLine>
   <SourceLine>System.Debuglog("[Write File] " + DeployFileDest.NativePath)</SourceLine>
   <SourceLine>DeployFileSource.CopyTo(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Windows" and TargetWindows Then</SourceLine>
   <SourceLine>// Windows Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileSource As FolderItem =  New FolderItem(WorkingDirectory.NativePath + "/Windows/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>If not DeployFileDest.Parent.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Create Folders] " + DeployFileDest.Parent.NativePath)</SourceLine>
   <SourceLine>ReactorWindow.CreateParentSubFolders(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Read File] " + DeployFileSource.NativePath)</SourceLine>
   <SourceLine>System.Debuglog("[Write File] " + DeployFileDest.NativePath)</SourceLine>
   <SourceLine>DeployFileSource.CopyTo(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Linux" and TargetLinux Then</SourceLine>
   <SourceLine>// Linux Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>Var DeployFileSource As FolderItem =  New FolderItem(WorkingDirectory.NativePath + "/Linux/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine>Var DeployFileDest As FolderItem =  New FolderItem(App.DeployFolder.NativePath + "/" + DeployOSVariant.StringValue)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployFileDest.Exists Then</SourceLine>
   <SourceLine>// Remove any legacy pre-existing files with the same filename</SourceLine>
   <SourceLine>DeployFileDest.Remove()</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>If not DeployFileDest.Parent.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Create Folders] " + DeployFileDest.Parent.NativePath)</SourceLine>
   <SourceLine>ReactorWindow.CreateParentSubFolders(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>System.Debuglog("[Read File] " + DeployFileSource.NativePath)</SourceLine>
   <SourceLine>System.Debuglog("[Write File] " + DeployFileDest.NativePath)</SourceLine>
   <SourceLine>DeployFileSource.CopyTo(DeployFileDest)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomStatus As String</SourceLine>
   <SourceLine>If DateTime.Now.Year = AtomDateYear Then</SourceLine>
   <SourceLine>AtomStatus = "New"</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AtomStatus = "OK"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + " Installed"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Donation</SourceLine>
   <SourceLine>If Atom.HasKey("Donation") Then</SourceLine>
   <SourceLine>Var AtomDonation As JSONItem = Atom.Value("Donation")</SourceLine>
   <SourceLine>Var Amount As String = ""</SourceLine>
   <SourceLine>Var URL As String = ""</SourceLine>
   <SourceLine>If AtomDonation.HasKey("URL") Then</SourceLine>
   <SourceLine>URL = AtomDonation.Value("URL").StringValue</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If AtomDonation.HasKey("Amount") Then</SourceLine>
   <SourceLine>Amount = AtomDonation.Value("Amount").StringValue</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Show a donate dialog</SourceLine>
   <SourceLine>Var Donation_Dialog As New MessageDialog</SourceLine>
   <SourceLine>Donation_Dialog.IconType = MessageDialog.IconTypes.Question</SourceLine>
   <SourceLine>Donation_Dialog.ActionButton.Caption = "Not right now... but I will consider it!"</SourceLine>
   <SourceLine>//Donation_Dialog.CancelButton.Visible = True</SourceLine>
   <SourceLine>Donation_Dialog.AlternateActionButton.Visible = True</SourceLine>
   <SourceLine>Donation_Dialog.AlternateActionButton.Caption = "Shut up and take my money!"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Amount &lt;&gt; "" Then</SourceLine>
   <SourceLine>Donation_Dialog.Message = "The author of the atom " + AtomID + " has suggested a donation of " + Amount</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Donation_Dialog.Message = "The author of the atom " + AtomID + " has suggested a donation."</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Donation_Dialog.Explanation = "Click the button to donate via the URL: " + URL</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var Donation_Dialog_Button As MessageDialogButton</SourceLine>
   <SourceLine>Donation_Dialog_Button = Donation_Dialog.ShowModal</SourceLine>
   <SourceLine>Select Case Donation_Dialog_Button</SourceLine>
   <SourceLine>Case Donation_Dialog.ActionButton</SourceLine>
   <SourceLine>// User pressed "Not right now... but I will consider it!"</SourceLine>
   <SourceLine>Case Donation_Dialog.AlternateActionButton</SourceLine>
   <SourceLine>// User pressed "Shut up and take my money!"</SourceLine>
   <SourceLine>System.GotoURL(URL)</SourceLine>
   <SourceLine>Case Donation_Dialog.CancelButton</SourceLine>
   <SourceLine>// User pressed "Cancel"</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>AtomInstalled</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1302185983</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AtomInstalled(AtomID As String) As Boolean</SourceLine>
   <SourceLine>Var DeployAtomsFile As FolderItem = App.DeployAtomsReactorFolder.Child(AtomID + ".atom")</SourceLine>
   <SourceLine>Var DeployJSONFile As FolderItem = App.DeployJSONReactorFolder.Child(AtomID + ".json")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If DeployAtomsFile.Exists Then</SourceLine>
   <SourceLine>// Atom file exists (legacy Reactor.lua install)</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>ElseIf DeployJSONFile.Exists Then</SourceLine>
   <SourceLine>// JSON file exists (Reactor.app install)</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>AtomID As String</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
 <Method>
  <ItemName>AtomUpdateAvailable</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1595957247</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AtomUpdateAvailable(InstalledAtomID As String) As Boolean</SourceLine>
   <SourceLine>If InstalledAtomID &lt;&gt; "" Then</SourceLine>
   <SourceLine>Var DeployAtomsFile As FolderItem = App.DeployAtomsReactorFolder.Child(InstalledAtomID + ".atom")</SourceLine>
   <SourceLine>Var DeployJSONFile As FolderItem = App.DeployJSONReactorFolder.Child(InstalledAtomID + ".json")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomExists As Integer = 0</SourceLine>
   <SourceLine>Var UpdateAtom As Integer = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If DeployAtomsFile.Exists and not DeployJSONFile.Exists Then</SourceLine>
   <SourceLine>// ATOM file exists (Reactor.lua install)</SourceLine>
   <SourceLine>AtomExists = 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// If the JSON atom file is not on disk, flag this as a legacy package that needs an update.</SourceLine>
   <SourceLine>// This will allow us to add a JSON atom for any pre-installed item.</SourceLine>
   <SourceLine>UpdateAtom = 1</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DeployJSONFile &lt;&gt; Nil and DeployJSONFile.Exists Then</SourceLine>
   <SourceLine>// JSON file exists (Reactor.app install)</SourceLine>
   <SourceLine>AtomExists = 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var InstalledJSONAtom As New JSONItem</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Read the JSON file to disk</SourceLine>
   <SourceLine>Var tos As TextInputStream</SourceLine>
   <SourceLine>If DeployJSONFile &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos = TextInputStream.Open(DeployJSONFile)</SourceLine>
   <SourceLine>if tos &lt;&gt; Nil Then</SourceLine>
   <SourceLine>InstalledJSONAtom.Load(tos.ReadAll())</SourceLine>
   <SourceLine>tos.Close</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Parse the atom file</SourceLine>
   <SourceLine>If InstalledJSONAtom &lt;&gt; Nil Then</SourceLine>
   <SourceLine>Var InstalledAtomDateJSON As JSONItem = InstalledJSONAtom.Value("Date")</SourceLine>
   <SourceLine>Var InstalledAtomDateYear As Double = InstalledAtomDateJSON.Value("1.0")</SourceLine>
   <SourceLine>Var InstalledAtomDateMonth As Double = InstalledAtomDateJSON.Value("2.0")</SourceLine>
   <SourceLine>Var InstalledAtomDateDay As Double = InstalledAtomDateJSON.Value("3.0")</SourceLine>
   <SourceLine>Var InstalledAtomDate As String = InstalledAtomDateYear.ToString(Locale.Current, "0000") + "-" + InstalledAtomDateMonth.ToString(Locale.Current, "00")  + "-"  + InstalledAtomDateDay.ToString(Locale.Current, "00")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor.json atom data</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// See if the atoms are the same</SourceLine>
   <SourceLine>If InstalledAtomID = AtomID Then</SourceLine>
   <SourceLine>Var AtomDateJSON As JSONItem = Atom.Value("Date")</SourceLine>
   <SourceLine>Var AtomDateYear As Double = AtomDateJSON.Value("1.0")</SourceLine>
   <SourceLine>Var AtomDateMonth As Double = AtomDateJSON.Value("2.0")</SourceLine>
   <SourceLine>Var AtomDateDay As Double = AtomDateJSON.Value("3.0")</SourceLine>
   <SourceLine>Var AtomDate As String = AtomDateYear.ToString(Locale.Current, "0000") + "-" + AtomDateMonth.ToString(Locale.Current, "00")  + "-"  + AtomDateDay.ToString(Locale.Current, "00")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If InstalledAtomDate = AtomDate Then</SourceLine>
