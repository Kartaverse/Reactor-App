 <ControlBehavior>
  <Superclass>Timer</Superclass>
  <HookInstance>
   <ItemName>Action</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>222375935</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
    <SourceLine>App.CreateReactorFolders()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Check if a download slot is open</SourceLine>
    <SourceLine>If App.DownloadList.Count = 0 Then</SourceLine>
    <SourceLine>// The Reactor app was quit with the CancelClosing "Complete Downloads, Then Quit" option.</SourceLine>
    <SourceLine>If App.QuitOnDownloadComplete = 1 Then</SourceLine>
    <SourceLine>App.QuitAllowed = 1</SourceLine>
    <SourceLine>Quit()</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If App.DownloadAtomID = "" Then</SourceLine>
    <SourceLine>If App.DownloadList.Count &gt;= 1 Then</SourceLine>
    <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
    <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
    <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
    <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
    <SourceLine>Var AtomName As String =  Atom.Value("Name")</SourceLine>
    <SourceLine>Var ZipFileURL As String =  Atom.Value("Zipfile")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Var AtomzFile As FolderItem = App.AtomzFolder.Child(AtomID + ".zip")</SourceLine>
    <SourceLine>If AtomUpdateAvailable(AtomID) = True then</SourceLine>
    <SourceLine>// Cancel the download task, and update the atom package</SourceLine>
    <SourceLine>AtomRemoveByAtomID(AtomID)</SourceLine>
    <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
    <SourceLine>If InstallState = False Then</SourceLine>
    <SourceLine>If App.DownloadList.IndexOf(AtomID) &lt;&gt; -1 Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.DownloadFilename = AtomzFile.Name</SourceLine>
    <SourceLine>App.DownloadFolderItem = AtomzFile</SourceLine>
    <SourceLine>App.DownloadAtomID = AtomID</SourceLine>
    <SourceLine>App.DownloadName = AtomName</SourceLine>
    <SourceLine>App.DownloadAtom = Atom</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Update the downloading status line</SourceLine>
    <SourceLine>For RefreshRow As Integer = 0 to AtomsListBox.RowCount - 1</SourceLine>
    <SourceLine>If AtomsListBox.CellTextAt(RefreshRow, 1) = AtomName Then</SourceLine>
    <SourceLine>AtomsListBox.CellTextAt(RefreshRow, 6) = "Downloading"</SourceLine>
    <SourceLine>AtomsListBox.RefreshCell(RefreshRow, 6)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>RSocket.Send("GET", ZipFileURL, AtomzFile)</SourceLine>
    <SourceLine>Catch error As UnsupportedOperationException</SourceLine>
    <SourceLine>System.DebugLog(error.Message + EndOfLine + " [Error] " + error.ErrorNumber.ToText)</SourceLine>
    <SourceLine>Catch error As RuntimeException</SourceLine>
    <SourceLine>System.DebugLog(error.Message + EndOfLine + " [Error] " + error.ErrorNumber.ToText)</SourceLine>
    <SourceLine>Catch error As IOException</SourceLine>
    <SourceLine>System.DebugLog(error.Message + EndOfLine + " [Error] " + error.ErrorNumber.ToText)</SourceLine>
    <SourceLine>Catch error As Xojo.IO.IOException</SourceLine>
    <SourceLine>System.DebugLog(error.Message + EndOfLine + " [Error] " + error.ErrorNumber.ToText)</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Exit For k //Break out of the loop</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
 </ControlBehavior>
 <ControlBehavior>
  <Superclass>Timer</Superclass>
  <HookInstance>
   <ItemName>Action</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>375087103</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>Var mManager As GameInputManager = New GameInputManager</SourceLine>
    <SourceLine>Var gCount As Integer = mManager.DeviceCount</SourceLine>
    <SourceLine>Var device As GameInputDevice</SourceLine>
    <SourceLine>Var deviceID As Integer = 0</SourceLine>
    <SourceLine>Var deviceName As String = ""</SourceLine>
    <SourceLine>Var i as Integer = 0</SourceLine>
    <SourceLine>For deviceID = 0 To gCount - 1</SourceLine>
    <SourceLine>device = mManager.Device(deviceID)</SourceLine>
    <SourceLine>If mManager.Device(deviceID) &lt;&gt; Nil Then</SourceLine>
    <SourceLine>deviceName =  mManager.Device(deviceID).Name</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Supported devices:</SourceLine>
    <SourceLine>// DualSense Wireless Controller</SourceLine>
    <SourceLine>// Kinesis JoyStick Controller</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If deviceName = "Kinesis JoyStick Controller " Then</SourceLine>
    <SourceLine>For i = 0 To device.ElementCount - 1</SourceLine>
    <SourceLine>Var mButton As GameInputElement = device.Element(i)</SourceLine>
    <SourceLine>If mButton &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var mButtonName As String = mButton.Name</SourceLine>
    <SourceLine>Var mButtonState As String =  mButton.Value.ToString</SourceLine>
    <SourceLine>Var row as Integer = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>If mButtonName = "Button #1" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Left Button = Atom List Up</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = 0 Then</SourceLine>
    <SourceLine>// Roll the selection around from the top to the bottom</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf AtomsListBox.SelectedRowIndex &gt;= 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.SelectedRowIndex - 1</SourceLine>
    <SourceLine>If AtomsListBox.ScrollPosition &gt; 0 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.ScrollPosition - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #2" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Centre Button = Atom Install</SourceLine>
    <SourceLine>If AtomsListbox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If row &gt;= 0 Then</SourceLine>
    <SourceLine>Var AtomIndex As Integer = AtomsListbox.CellTagAt(row, 1).IntegerValue</SourceLine>
    <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
    <SourceLine>If Atom &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Is the atom installed already</SourceLine>
    <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If InstallState = False Then</SourceLine>
    <SourceLine>AtomsListBox.CellTagAt(row, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
    <SourceLine>AtomsListBox.CellCheckBoxStateAt(row, 0) = AtomsListBox.CellTagAt(row, 0)</SourceLine>
    <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
    <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
    <SourceLine>ElseIf InstallState = True Then</SourceLine>
    <SourceLine>AtomsListBox.CellTagAt(row, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
    <SourceLine>AtomsListBox.CellCheckBoxStateAt(row, 0) = AtomsListBox.CellTagAt(row, 0)</SourceLine>
    <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
    <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>AtomRemoveByAtomID(AtomID)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Cleanup Atom View</SourceLine>
    <SourceLine>If RepoPopupMenu.SelectedRowIndex = 1 or  RepoPopupMenu.SelectedRowIndex = 7 Then</SourceLine>
    <SourceLine>// Applies to Install or Download views</SourceLine>
    <SourceLine>Var rowPrevious As Integer = row</SourceLine>
    <SourceLine>Var ScrollPositionPrevious As Integer = AtomsListBox.ScrollPosition</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>AtomsRefresh()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Keep Selection point</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1 </SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If rowPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = rowPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If ScrollPositionPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = ScrollPositionPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #3" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Right Button = Atom List Down</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>// Roll the selection around from the bottom to the top</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf AtomsListBox.SelectedRowIndex &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.SelectedRowIndex + 1</SourceLine>
    <SourceLine>If AtomsListBox.ScrollPosition &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.ScrollPosition + 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>ElseIf deviceName = "DualSense Wireless Controller" Then</SourceLine>
    <SourceLine>For i = 0 To device.ElementCount - 1</SourceLine>
    <SourceLine>Var mButton As GameInputElement = device.Element(i)</SourceLine>
    <SourceLine>If mButton &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var mButtonName As String = mButton.Name</SourceLine>
    <SourceLine>Var mButtonState As String =  mButton.Value.ToString</SourceLine>
    <SourceLine>Var row as Integer = AtomsListBox.SelectedRowIndex </SourceLine>
    <SourceLine>// Look into the analog joysticks for adjustable speed control</SourceLine>
    <SourceLine>If mButtonName = "Button #1" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Square Button = Cancel</SourceLine>
    <SourceLine>AtomDownloadCancel()</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #2" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// X = Install/Uninstall</SourceLine>
    <SourceLine>If AtomsListbox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If row &gt;= 0 Then</SourceLine>
    <SourceLine>Var AtomIndex As Integer = AtomsListbox.CellTagAt(row, 1).IntegerValue</SourceLine>
    <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
    <SourceLine>If Atom &lt;&gt; Nil Then</SourceLine>
    <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Is the atom installed already</SourceLine>
    <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If InstallState = False Then</SourceLine>
    <SourceLine>AtomsListBox.CellTagAt(row, 0) = DesktopCheckbox.VisualStates.Indeterminate</SourceLine>
    <SourceLine>AtomsListBox.CellCheckBoxStateAt(row, 0) = AtomsListBox.CellTagAt(row, 0)</SourceLine>
    <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
    <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>AtomDownloadQueue(AtomID, Atom)</SourceLine>
    <SourceLine>ElseIf InstallState = True Then</SourceLine>
    <SourceLine>AtomsListBox.CellTagAt(row, 0) = DesktopCheckbox.VisualStates.Unchecked</SourceLine>
    <SourceLine>AtomsListBox.CellCheckBoxStateAt(row, 0) = AtomsListBox.CellTagAt(row, 0)</SourceLine>
    <SourceLine>For c As Integer = 0 to AtomsListBox.ColumnCount - 1</SourceLine>
    <SourceLine>AtomsListBox.RefreshCell(row, c)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>AtomRemoveByAtomID(AtomID)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Cleanup Atom View</SourceLine>
    <SourceLine>If RepoPopupMenu.SelectedRowIndex = 1 or  RepoPopupMenu.SelectedRowIndex = 7 Then</SourceLine>
    <SourceLine>// Applies to Install or Download views</SourceLine>
    <SourceLine>Var rowPrevious As Integer = row</SourceLine>
    <SourceLine>Var ScrollPositionPrevious As Integer = AtomsListBox.ScrollPosition</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>AtomsRefresh()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Keep Selection point</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1 </SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If rowPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = rowPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If ScrollPositionPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = ScrollPositionPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #3" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Circle = Refresh View</SourceLine>
    <SourceLine>Var rowPrevious As Integer = row</SourceLine>
    <SourceLine>Var ScrollPositionPrevious As Integer = AtomsListBox.ScrollPosition</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>AtomsRefresh()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Keep Selection point</SourceLine>
    <SourceLine>If rowPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = rowPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If ScrollPositionPrevious &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = ScrollPositionPrevious</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #4" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// Triangle = About Reactor</SourceLine>
    <SourceLine>If AboutWindow.Visible = False Then</SourceLine>
    <SourceLine>AboutWindow.Show</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>AboutWindow.Hide</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #5" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// L1 = Change Category Up</SourceLine>
    <SourceLine>If CategoryListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If CategoryListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If CategoryListBox.SelectedRowIndex = 0 Then</SourceLine>
    <SourceLine>// Roll the selection around from the top to the bottom</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = CategoryListBox.RowCount - 1</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf CategoryListBox.SelectedRowIndex &gt;= 1 Then</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = CategoryListBox.SelectedRowIndex - 1</SourceLine>
    <SourceLine>If CategoryListBox.ScrollPosition &gt; 0 Then</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.ScrollPosition - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #7" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// L2 = Change Category Down</SourceLine>
    <SourceLine>If CategoryListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If CategoryListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If CategoryListBox.SelectedRowIndex = CategoryListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>// Roll the selection around from the bottom to the top</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf CategoryListBox.SelectedRowIndex &lt;= CategoryListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>CategoryListBox.SelectedRowIndex = CategoryListBox.SelectedRowIndex + 1</SourceLine>
    <SourceLine>If CategoryListBox.ScrollPosition &lt;= CategoryListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>CategoryListBox.ScrollPosition = CategoryListBox.ScrollPosition + 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #8" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// R2 = Repo view mode down</SourceLine>
    <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
    <SourceLine>Case 0</SourceLine>
    <SourceLine>// All</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 1</SourceLine>
    <SourceLine>Case 1</SourceLine>
    <SourceLine>// Update</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 2</SourceLine>
    <SourceLine>Case 2</SourceLine>
    <SourceLine>// Installed</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 3</SourceLine>
    <SourceLine>Case 3</SourceLine>
    <SourceLine>// Uninstalled</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 4</SourceLine>
    <SourceLine>Case 4</SourceLine>
    <SourceLine>// Donate</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 5</SourceLine>
    <SourceLine>Case 5</SourceLine>
    <SourceLine>// New</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 6</SourceLine>
    <SourceLine>Case 6</SourceLine>
    <SourceLine>// Dependencies</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 8</SourceLine>
    <SourceLine>Case 7</SourceLine>
    <SourceLine>// Incompatible</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 0</SourceLine>
    <SourceLine>Case 8</SourceLine>
    <SourceLine>// Downloading</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 0</SourceLine>
    <SourceLine>End Select</SourceLine>
    <SourceLine>ElseIf mButtonName = "Button #6" and mButtonState = "1" Then</SourceLine>
    <SourceLine>// R1 = Repo view mode up</SourceLine>
    <SourceLine>Select Case RepoPopupMenu.SelectedRowIndex</SourceLine>
    <SourceLine>Case 0</SourceLine>
    <SourceLine>// All</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 8</SourceLine>
    <SourceLine>Case 1</SourceLine>
    <SourceLine>// Update</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 0</SourceLine>
    <SourceLine>Case 2</SourceLine>
    <SourceLine>// Installed</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 1</SourceLine>
    <SourceLine>Case 3</SourceLine>
    <SourceLine>// Uninstalled</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 2</SourceLine>
    <SourceLine>Case 4</SourceLine>
    <SourceLine>// Donate</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 3</SourceLine>
    <SourceLine>Case 5</SourceLine>
    <SourceLine>// New</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 4</SourceLine>
    <SourceLine>Case 6</SourceLine>
    <SourceLine>// Dependencies</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 5</SourceLine>
    <SourceLine>Case 7</SourceLine>
    <SourceLine>// Incompatible</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 0</SourceLine>
    <SourceLine>Case 8</SourceLine>
    <SourceLine>// Downloading</SourceLine>
    <SourceLine>RepoPopupMenu.SelectedRowIndex = 6</SourceLine>
    <SourceLine>End Select</SourceLine>
    <SourceLine>ElseIf mButtonName = "Y-Axis" Then</SourceLine>
    <SourceLine>// Left Joystick Y-axis = Atom List Select Next Item = Up/Down</SourceLine>
    <SourceLine>// Allow up and down with proportial scrolling speed</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If mButtonState.Val &lt; (127 - 16) or mButtonState.Val &gt; (127 + 16) Then</SourceLine>
    <SourceLine>// Scale the 0-255 value into a floating point -0.5 to 0.5 input range</SourceLine>
    <SourceLine>Var ScrollFloat As Double = mButtonState.Val</SourceLine>
    <SourceLine>ScrollFloat = ScrollFloat / 255</SourceLine>
    <SourceLine>ScrollFloat = ScrollFloat - 0.5</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Accelerate scrolling at the far ends of the range control</SourceLine>
    <SourceLine>Var ScrollRate As Double = 2</SourceLine>
    <SourceLine>If mButtonState.Val &lt; 2 or mButtonState.Val &gt; 253 Then</SourceLine>
    <SourceLine>ScrollRate = 30</SourceLine>
    <SourceLine>elseif mButtonState.Val &lt; 32 or mButtonState.Val &gt; 223 Then</SourceLine>
    <SourceLine>ScrollRate = 8</SourceLine>
    <SourceLine>elseif mButtonState.Val &lt; 64 or mButtonState.Val &gt; 191 Then</SourceLine>
    <SourceLine>ScrollRate = 5</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Apply the speed factors</SourceLine>
    <SourceLine>ScrollFloat = ScrollFloat * ScrollRate</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Clamp Values</SourceLine>
    <SourceLine>Var ScrollInteger As Integer = AtomsListBox.ScrollPosition + ScrollFloat</SourceLine>
    <SourceLine>If ScrollInteger &lt;= 0 Then</SourceLine>
    <SourceLine>ScrollInteger = 0</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If ScrollInteger &gt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>ScrollInteger = AtomsListBox.RowCount - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Var SelectedOffset As Integer = (AtomsListBox.SelectedRowIndex - AtomsListBox.ScrollPosition) + ScrollInteger</SourceLine>
    <SourceLine>If SelectedOffset &lt;= 0 Then</SourceLine>
    <SourceLine>SelectedOffset = 0</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If SelectedOffset &gt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>SelectedOffset = AtomsListBox.RowCount - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>// Left analog joystick</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = ScrollInteger</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = SelectedOffset</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Z-Rotation" Then</SourceLine>
    <SourceLine>// Left Joystick Y-axis = Atom List Select Next Item = Up/Down</SourceLine>
    <SourceLine>// Allow up and down with proportial scrolling speed</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If mButtonState.Val &lt; (127 - 16) or mButtonState.Val &gt; (127 + 16) Then</SourceLine>
    <SourceLine>// Webpage scroll distance in pixels (+/- 128 pixel offset control range)</SourceLine>
    <SourceLine>Dim Scroll_Pixels As Integer =  mButtonState.Val - 127</SourceLine>
    <SourceLine>Dim Javascript_Code As String = "window.scrollBy(0, " + Str(Scroll_Pixels) + ");"</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Execute the JavaScript code snippet</SourceLine>
    <SourceLine>DescriptionHTMLViewer.ExecuteJavaScript(Javascript_Code)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf mButtonName = "Hatswitch" and mButtonState = "0" Then</SourceLine>
    <SourceLine>// Hatswitch Up = Atom List Select Next Item = Up</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = 0 Then</SourceLine>
    <SourceLine>// Roll the selection around from the top to the bottom</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf AtomsListBox.SelectedRowIndex &gt;= 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.SelectedRowIndex - 1</SourceLine>
    <SourceLine>If AtomsListBox.ScrollPosition &gt; 0 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.ScrollPosition - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Elseif mButtonName = "Hatswitch" and mButtonState = "4" Then</SourceLine>
    <SourceLine>// Hatswitch Down = Atom List Select Next Item = Down</SourceLine>
    <SourceLine>If AtomsListBox.RowCount - 1 &gt;= 0 Then</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = -1 Then</SourceLine>
    <SourceLine>// If nothing is selected select the first row</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If AtomsListBox.SelectedRowIndex = AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>// Roll the selection around from the bottom to the top</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = 0</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.SelectedRowIndex</SourceLine>
    <SourceLine>ElseIf AtomsListBox.SelectedRowIndex &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.SelectedRowIndex = AtomsListBox.SelectedRowIndex + 1</SourceLine>
    <SourceLine>If AtomsListBox.ScrollPosition &lt;= AtomsListBox.RowCount - 1 Then</SourceLine>
    <SourceLine>AtomsListBox.ScrollPosition = AtomsListBox.ScrollPosition + 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>Catch error As RuntimeException</SourceLine>
    <SourceLine>System.DebugLog("Warning... USB Down"  + EndOfLine + EndOfLine + error.Message)</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
