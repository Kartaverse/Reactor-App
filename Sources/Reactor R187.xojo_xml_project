        <SourceLine>Try</SourceLine>
        <SourceLine>If AtomDependencies.Keys &lt;&gt; Nil Then</SourceLine>
        <SourceLine>For Each k As String In AtomDependencies.Keys</SourceLine>
        <SourceLine>Var DependenciesVariant As Variant = AtomDependencies.Value(k)</SourceLine>
        <SourceLine>App.DownloadDependencies().Add(DependenciesVariant.StringValue)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>MessageBox(error.Message)</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// De-duplicate array entries</SourceLine>
        <SourceLine>App.DownloadDependencies.Sort</SourceLine>
        <SourceLine>for i As integer = App.DownloadDependencies.Ubound - 1 downto 0</SourceLine>
        <SourceLine>if App.DownloadDependencies(i) = App.DownloadDependencies(i + 1) then App.DownloadDependencies.Remove(i)</SourceLine>
        <SourceLine>next</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
