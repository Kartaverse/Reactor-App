  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AtomImportLegacyReactor(Host As String)</SourceLine>
   <SourceLine>// Choose what folder to scan</SourceLine>
   <SourceLine>Var LegacyReactorFolder As FolderItem</SourceLine>
   <SourceLine>If Host =  "Fusion" Then</SourceLine>
   <SourceLine>// Fusion Studio</SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// C:\ProgramData\Blackmagic Design\Fusion\Reactor\</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /Library/Application Support/Blackmagic Design/Fusion/Reactor/</SourceLine>
   <SourceLine>ElseIf TargetLinux Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.Variable.Child("Blackmagic Design").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /var/BlackmagicDesign/Fusion/Reactor/</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf Host = "Resolve" Then</SourceLine>
   <SourceLine>// Resolve Free/Studio</SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// C:\ProgramData\Blackmagic Design\DaVinci Resolve\Fusion\Reactor\</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Reactor/</SourceLine>
   <SourceLine>ElseIf TargetLinux Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.Variable.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /var/BlackmagicDesign/DaVinci Resolve/Fusion/Reactor/</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>// Fallback when nothing specified for the host</SourceLine>
   <SourceLine>// Resolve Free/Studio</SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// C:\ProgramData\Blackmagic Design\DaVinci Resolve\Fusion\Reactor\</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Reactor/</SourceLine>
   <SourceLine>ElseIf TargetLinux Then</SourceLine>
   <SourceLine>LegacyReactorFolder = SpecialFolder.Variable.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor").Child("Deploy").Child("Atoms").Child("Reactor")</SourceLine>
   <SourceLine>// /var/BlackmagicDesign/DaVinci Resolve/Fusion/Reactor/</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Process the legacy Reactor folder content</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If LegacyReactorFolder.Exists and LegacyReactorFolder.IsFolder and  LegacyReactorFolder.IsReadable Then</SourceLine>
   <SourceLine>For Each file As FolderItem In LegacyReactorFolder.Children</SourceLine>
   <SourceLine>If file.Visible = True and file.Extension = "atom" Then</SourceLine>
   <SourceLine>Var re As New RegEx</SourceLine>
   <SourceLine>re.SearchPattern = "[.]atom$"</SourceLine>
   <SourceLine>re.ReplacementPattern = ""</SourceLine>
   <SourceLine>re.Options.ReplaceAllMatches = True</SourceLine>
   <SourceLine>Var destName As String = re.Replace(file.Name)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Scan for .atom files in this folder</SourceLine>
   <SourceLine>App.DownloadList().Add(destName)</SourceLine>
   <SourceLine>// MessageBox(destName)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As NilObjectException</SourceLine>
   <SourceLine>// Fallback Resolution</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// De-duplicate array entries</SourceLine>
   <SourceLine>App.DownloadList.Sort</SourceLine>
   <SourceLine>For i As Integer = App.DownloadList.Ubound - 1 DownTo 0</SourceLine>
   <SourceLine>if App.DownloadList(i) = App.DownloadList(i + 1) Then App.DownloadList.Remove(i)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Switch to the download view mode</SourceLine>
   <SourceLine>RepoPopupMenu.SelectRowWithText("Downloading")</SourceLine>
