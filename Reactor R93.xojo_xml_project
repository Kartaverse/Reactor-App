      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomDownload(row As Integer)</SourceLine>
        <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
        <SourceLine>CreateReactorFolders()</SourceLine>
        <SourceLine/>
        <SourceLine>If row &gt;= 0 Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>Var CellString As String = AtomsListBox.CellTextAt(row, 1)</SourceLine>
        <SourceLine>Var AtomIndex As Integer = AtomsListBox.CellTagAt(row, 0).IntegerValue</SourceLine>
        <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
        <SourceLine/>
        <SourceLine>Var ID As String = Atom.Value("ID")</SourceLine>
        <SourceLine>Var ZipFileURL As String =  Atom.Value("Zipfile")</SourceLine>
        <SourceLine/>
        <SourceLine>Var AtomzFolder As FolderItem = SpecialFolder.UserHome.Child("Reactor").Child("Atomz")</SourceLine>
