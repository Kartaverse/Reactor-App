          <SourceLine/>
          <SourceLine>// Row selection bold highlight</SourceLine>
          <SourceLine>For row As Integer = Me.RowCount -1 DownTo 0</SourceLine>
          <SourceLine>if Me.SelectedRowIndex = row Then</SourceLine>
          <SourceLine>Me.CellBoldAt(row, 0) = True</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>Me.CellBoldAt(row, 0) = False</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine/>
          <SourceLine>// Display active selection</SourceLine>
          <SourceLine>Var SelectedMode As String = Me.CellTextAt(Me.SelectedRowIndex, 0)</SourceLine>
