<block type="DesktopWindow" ID="338128895">
 <ObjName>ReactorWindow</ObjName>
 <ObjContainerID>0</ObjContainerID>
 <IsClass>1</IsClass>
 <Superclass>DesktopWindow</Superclass>
 <ItemFlags>1</ItemFlags>
 <IsInterface>0</IsInterface>
 <Compatibility></Compatibility>
 <HookInstance>
  <ItemName>Opening</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1037426687</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Opening()</SourceLine>
   <SourceLine>// Load the JSON values as the Window position</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("MainWindow") Then</SourceLine>
   <SourceLine>Var jsonWindow As JSONItem = App.Settings.Value("MainWindow")</SourceLine>
   <SourceLine>Var Val As String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If jsonWindow.HasKey("Top") Then</SourceLine>
   <SourceLine>Val = jsonWindow.Value("Top")</SourceLine>
   <SourceLine>Me.Top = Val.ToInteger</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>// Avoid running this code on WindowsOS as the ReactorWindow title bar will dock above the top row of the display</SourceLine>
   <SourceLine>Me.Top = DesktopDisplay.DisplayAt(0).AvailableTop + 28</SourceLine>
   <SourceLine>System.DebugLog("[Settings Read] No Reactor window top coordinates found.")</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If jsonWindow.HasKey("Left") Then</SourceLine>
   <SourceLine>Val = jsonWindow.Value("Left")</SourceLine>
   <SourceLine>Me.Left = Val.ToInteger</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>// Avoid running this code on WindowsOS as the ReactorWindow title bar will dock above the top row of the display</SourceLine>
   <SourceLine>Me.Left = DesktopDisplay.DisplayAt(0).AvailableLeft</SourceLine>
   <SourceLine>System.DebugLog("[Settings Read] No Reactor window left coordinates found.")</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If jsonWindow.HasKey("Width") Then</SourceLine>
   <SourceLine>Val = jsonWindow.Value("Width")</SourceLine>
   <SourceLine>Me.Width = Val.ToInteger</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>// Me.Width = DesktopDisplay.DisplayAt(0).AvailableWidth</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If jsonWindow.HasKey("Height") Then</SourceLine>
   <SourceLine>Val = jsonWindow.Value("Height")</SourceLine>
   <SourceLine>Me.Height = Val.ToInteger</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>// Me.Height = DesktopDisplay.DisplayAt(0).AvailableHeight - 28</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>System.DebugLog("[Settings Read] No Reactor window coordinates found.")</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Control the gamepad Input timer</SourceLine>
   <SourceLine>If App.GamepadSupport = 1 Then</SourceLine>
   <SourceLine>InputDevicesTimer.Enabled = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>InputDevicesTimer.Enabled = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
   <SourceLine>App.CreateReactorFolders()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Turn the download queue on</SourceLine>
   <SourceLine>ReactorWindow.QueueTimer.RunMode = Timer.RunModes.Multiple</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Download the Reactor.json file</SourceLine>
   <SourceLine>JSONDownload()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Update the listboxes</SourceLine>
   <SourceLine>CategoryRefresh()</SourceLine>
   <SourceLine>AtomsRefresh()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor.json data processed</SourceLine>
   <SourceLine>DownloadStatsLabel.Text = ""</SourceLine>
   <SourceLine>DownloadProgress.Value = 0</SourceLine>
   <SourceLine>DownloadProgress.Visible = False</SourceLine>
   <SourceLine>// CancelButton.Visible = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
 </HookInstance>
 <HookInstance>
  <ItemName>CancelClosing</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>826646527</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function CancelClosing(appQuitting As Boolean) As Boolean</SourceLine>
   <SourceLine>System.DebugLog("[Download Queue Contents]")</SourceLine>
   <SourceLine>System.DebugLog(String.FromArray(App.DownloadList, EndOfLine))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// The CancelClosing event is called when the app receives the quit signal</SourceLine>
   <SourceLine>If App.DownloadList.Count &gt;= 1 and App.QuitAllowed = 0 Then</SourceLine>
   <SourceLine> // Create the MessageDialog object</SourceLine>
   <SourceLine>Var Quit_Message_Dialog As New MessageDialog</SourceLine>
   <SourceLine>// Display warning icon</SourceLine>
   <SourceLine>Quit_Message_Dialog.IconType = MessageDialog.IconTypes.Caution </SourceLine>
   <SourceLine>Quit_Message_Dialog.ActionButton.Caption = "Quit"</SourceLine>
   <SourceLine>// Show the Cancel button</SourceLine>
   <SourceLine>Quit_Message_Dialog.CancelButton.Visible = True                </SourceLine>
   <SourceLine>Quit_Message_Dialog.Message = "Do you want to quit Reactor?"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Handle the result</SourceLine>
   <SourceLine>Var Quit_Message_Dialog_Button As MessageDialogButton             </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Display the dialog    </SourceLine>
   <SourceLine>Quit_Message_Dialog_Button = Quit_Message_Dialog.ShowModal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Determine which button was pressed.</SourceLine>
   <SourceLine>Select Case Quit_Message_Dialog_Button              </SourceLine>
   <SourceLine>Case Quit_Message_Dialog.ActionButton</SourceLine>
   <SourceLine>// User pressed "Quit"</SourceLine>
   <SourceLine>// Go ahead and quit the program</SourceLine>
   <SourceLine>ReactorWindow.AtomDownloadCancel()</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>Case Quit_Message_Dialog.AlternateActionButton</SourceLine>
   <SourceLine>// User pressed "Complete Downloads, Then Quit</SourceLine>
   <SourceLine>// Do something with a deferred RSocket event handler</SourceLine>
   <SourceLine>App.QuitOnDownloadComplete = 1</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>Case Quit_Message_Dialog.CancelButton</SourceLine>
   <SourceLine>// User pressed "Cancel"</SourceLine>
   <SourceLine>// Cancel the quit event and let the program continue running</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
 </HookInstance>
