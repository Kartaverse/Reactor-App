  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ToolsImportLegacyReactorAtoms() As Boolean</SourceLine>
   <SourceLine>// Create the MessageDialog object</SourceLine>
   <SourceLine>Var Atom_Import_Dialog As New MessageDialog</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Display warning icon</SourceLine>
   <SourceLine>Atom_Import_Dialog.IconType = MessageDialog.IconTypes.Caution </SourceLine>
   <SourceLine>Atom_Import_Dialog.Message = "Do you want to import atom packages from a previous Reactor installation?"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Atom_Import_Dialog.ActionButton.Caption = "Import Resolve Free/Studio Atoms"</SourceLine>
   <SourceLine>Atom_Import_Dialog.AlternateActionButton.Caption = "Import Fusion Studio Atoms"</SourceLine>
   <SourceLine>Atom_Import_Dialog.AlternateActionButton.Visible = True</SourceLine>
   <SourceLine>Atom_Import_Dialog.CancelButton.Visible = True                </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Handle the result</SourceLine>
   <SourceLine>Var Atom_Import_Dialog_Button As MessageDialogButton             </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Display the dialog    </SourceLine>
   <SourceLine>Atom_Import_Dialog_Button  = Atom_Import_Dialog.ShowModal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Determine which button was pressed.</SourceLine>
   <SourceLine>Select Case Atom_Import_Dialog_Button              </SourceLine>
   <SourceLine>Case Atom_Import_Dialog.ActionButton</SourceLine>
   <SourceLine>// Resolve Free/Studio Host</SourceLine>
   <SourceLine>AtomImportLegacyReactor("Resolve")</SourceLine>
   <SourceLine>Case Atom_Import_Dialog.AlternateActionButton</SourceLine>
   <SourceLine>// Fusion Studio Host</SourceLine>
   <SourceLine>AtomImportLegacyReactor("Fusion")</SourceLine>
   <SourceLine>Case Atom_Import_Dialog.CancelButton</SourceLine>
   <SourceLine>// User pressed "Cancel"</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
