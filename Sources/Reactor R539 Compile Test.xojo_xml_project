      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub AtomDownloadQueue(AtomID As String, Atom As JSONItem)</SourceLine>
        <SourceLine>// Todo: </SourceLine>
        <SourceLine>// Check if an installed atom has an update</SourceLine>
        <SourceLine>// If a package is installed, verify if any missing dependencies are required</SourceLine>
        <SourceLine>// Don't reinstall an atom if no update is needed (json exists and date is the same on disk)</SourceLine>
        <SourceLine/>
        <SourceLine>// Is the atom installed already</SourceLine>
        <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
        <SourceLine>If InstallState = False Then</SourceLine>
        <SourceLine>// Add the atom package to the download queue</SourceLine>
        <SourceLine>App.DownloadList().Add(AtomID)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Add the dependencies for this package</SourceLine>
        <SourceLine>If Atom &lt;&gt; Nil and Atom.HasKey("Dependencies") Then</SourceLine>
        <SourceLine>Var DependencyList As JSONItem = Atom.Value("Dependencies")</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If DependencyList.Keys &lt;&gt; Nil Then</SourceLine>
        <SourceLine>For Each k As String In DependencyList.Keys</SourceLine>
        <SourceLine>Var DependenciesVariant As Variant = DependencyList.Value(k)</SourceLine>
        <SourceLine>// Add the dependencies to the download queue</SourceLine>
        <SourceLine>App.DownloadList().Add(DependenciesVariant.StringValue)</SourceLine>
        <SourceLine>Next</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>MessageBox(error.Message)</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// De-duplicate array entries</SourceLine>
        <SourceLine>App.DownloadList.Sort</SourceLine>
        <SourceLine>For i As Integer = App.DownloadList.Ubound - 1 DownTo 0</SourceLine>
        <SourceLine>If App.DownloadList(i) = App.DownloadList(i + 1) Then </SourceLine>
        <SourceLine>App.DownloadList.Remove(i)</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Next</SourceLine>
