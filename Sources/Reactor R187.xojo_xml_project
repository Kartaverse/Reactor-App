        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged()</SourceLine>
          <SourceLine>Var row As Integer = Me.SelectedRowIndex</SourceLine>
          <SourceLine>If row &gt;= 0 Then</SourceLine>
          <SourceLine>Var CellString As String = Me.CellTextAt(row, 1)</SourceLine>
          <SourceLine>Var AtomIndex As Integer = Me.CellTagAt(row, 1).IntegerValue</SourceLine>
          <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
          <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
          <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
          <SourceLine>Var SelectedAtom As String = AtomID</SourceLine>
          <SourceLine/>
          <SourceLine>System.Debuglog("[Atom Selected] " + SelectedAtom)</SourceLine>
          <SourceLine>DownloadStatsLabel.Text = SelectedAtom + ".zip Selected"</SourceLine>
          <SourceLine/>
          <SourceLine>Var HTML As String = App.Header + AtomDescription + HTMLDonation(Atom) +  HTMLDependencies(Atom) + HTMLDeployFilesList(Atom) + App.Footer</SourceLine>
          <SourceLine>//HTML = HTML.ReplaceAll("Reactor:", SpecialFolder.UserHome.Child("Reactor").Child("Deploy").NativePath)</SourceLine>
          <SourceLine>Var DeployHTMLFile As FolderItem = SpecialFolder.UserHome.Child("Reactor").Child("Deploy").TemporaryFile.Child("index.html")</SourceLine>
          <SourceLine/>
          <SourceLine>DescriptionHTMLViewer.LoadPage(HTML, DeployHTMLFile)</SourceLine>
          <SourceLine>End</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>CellPressed</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>316995583</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function CellPressed(row As Integer, column As Integer, x As Integer, y As Integer) As Boolean</SourceLine>
          <SourceLine>If me.RowCount &gt;= 1 Then</SourceLine>
          <SourceLine>Var AtomIndex As Integer = Me.CellTagAt(row, 1).IntegerValue</SourceLine>
          <SourceLine>Var Atom As JSONItem = App.Atoms.Value(AtomIndex.ToString())</SourceLine>
          <SourceLine>If Atom &lt;&gt; Nil Then</SourceLine>
          <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
          <SourceLine/>
          <SourceLine>If row &gt;= 0 And column &gt;= 1 Then</SourceLine>
          <SourceLine>Var CellString As String = Me.CellTextAt(row, 1)</SourceLine>
          <SourceLine>Var SelectedAtom As String = AtomID</SourceLine>
          <SourceLine>Var AtomDescription As String =  Atom.Value("Description")</SourceLine>
          <SourceLine>System.Debuglog("[Atom Description] " + SelectedAtom)</SourceLine>
          <SourceLine/>
          <SourceLine>Var HTML As String = App.Header + AtomDescription + HTMLDonation(Atom) +  HTMLDependencies(Atom) + HTMLDeployFilesList(Atom) + App.Footer</SourceLine>
          <SourceLine>//HTML = HTML.ReplaceAll("Reactor:", SpecialFolder.UserHome.Child("Reactor").Child("Deploy").NativePath)</SourceLine>
          <SourceLine>Var DeployHTMLFile As FolderItem = SpecialFolder.UserHome.Child("Reactor").Child("Deploy").TemporaryFile.Child("index.html")</SourceLine>
          <SourceLine/>
          <SourceLine>DescriptionHTMLViewer.LoadPage(HTML, DeployHTMLFile)</SourceLine>
          <SourceLine>End</SourceLine>
          <SourceLine/>
          <SourceLine>// The install checkbox column was clicked on</SourceLine>
          <SourceLine>If row &gt;= 0 and column = 0 Then</SourceLine>
          <SourceLine>// Is the atom installed already</SourceLine>
          <SourceLine>Var InstallState As Boolean = AtomInstalled(AtomID)</SourceLine>
          <SourceLine>// Verify no active downloads are in progress</SourceLine>
          <SourceLine/>
          <SourceLine>If AtomUpdateAvailable(AtomID) = True then</SourceLine>
          <SourceLine>// Cancel the download task, and update the atom package</SourceLine>
          <SourceLine>If App.DownloadRow = -1 Then</SourceLine>
          <SourceLine>AtomRemove(row)</SourceLine>
          <SourceLine>AtomDownload(row)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>ElseIf InstallState = True then</SourceLine>
          <SourceLine>// Remove the package</SourceLine>
          <SourceLine>If App.DownloadRow = -1 Then</SourceLine>
          <SourceLine>AtomRemove(row)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>ElseIf InstallState = False Then</SourceLine>
          <SourceLine>If App.DownloadRow = -1 Then</SourceLine>
          <SourceLine>// Download the package</SourceLine>
          <SourceLine>AtomDownload(row)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>//AtomsRefresh()</SourceLine>
          <SourceLine/>
          <SourceLine>For RefreshRow As Integer = 0 to AtomsListBox.RowCount - 1</SourceLine>
          <SourceLine>AtomsListBox.CellCheckBoxStateAt(RefreshRow, 0) = AtomsListBox.CellTagAt(RefreshRow, 0)</SourceLine>
          <SourceLine>AtomsListBox.RefreshCell(RefreshRow, 0)</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintCellText</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1413482495</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellText(g as Graphics, row as Integer, column as Integer, x as Integer, y as Integer) As Boolean</SourceLine>
          <SourceLine>Select Case Me.CellTextAt(row, 6)</SourceLine>
          <SourceLine>Case "OK"</SourceLine>
          <SourceLine>// Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(144, 144, 144)</SourceLine>
          <SourceLine>Case "Downloading"</SourceLine>
          <SourceLine>// Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(144, 144, 144)</SourceLine>
          <SourceLine>Case "Removing"</SourceLine>
          <SourceLine>// Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(144, 144, 144)</SourceLine>
          <SourceLine>Case "Update"</SourceLine>
          <SourceLine>// Upgrade Blue</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(140,153, 214)</SourceLine>
          <SourceLine>Case "New"</SourceLine>
          <SourceLine>// New Green</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(140, 214, 153)</SourceLine>
          <SourceLine>Case "Disabled"</SourceLine>
          <SourceLine>// Faint Red</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(255, 139, 140)</SourceLine>
          <SourceLine>Case "Incompatible"</SourceLine>
          <SourceLine>// Faint Red</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(255, 139, 140)</SourceLine>
          <SourceLine>End Select</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine/>
          <SourceLine/>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
