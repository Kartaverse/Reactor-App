          <SourceLine/>
          <SourceLine>// Draw the package count number</SourceLine>
          <SourceLine>ItemCount = App.JSONStateCount.Value("Dependencies")</SourceLine>
          <SourceLine>If ItemCount &gt; 0 Then</SourceLine>
          <SourceLine>g.DrawText(ItemCount.ToString(), g.width - 30, y, g.width, True)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Case "Donate"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine/>
          <SourceLine>// Draw the package count number</SourceLine>
