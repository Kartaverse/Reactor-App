        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub Pressed()</SourceLine>
          <SourceLine>ConnectDialogWindow.Close</SourceLine>
          <SourceLine/>
          <SourceLine>// Path where Reactor downloads are saved</SourceLine>
          <SourceLine>Var ReactorInstallDirectory As String = SpecialFolder.UserHome.Child("Reactor").NativePath</SourceLine>
          <SourceLine/>
          <SourceLine>If TargetWindows Then</SourceLine>
          <SourceLine>// Windows Slash Direction - Already has a trailing slash by default</SourceLine>
          <SourceLine>//ReactorInstallDirectory = ReactorInstallDirectory + "\"</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// MacOS/Linux Slash Direction</SourceLine>
          <SourceLine>ReactorInstallDirectory = ReactorInstallDirectory + "/"</SourceLine>
          <SourceLine>End</SourceLine>
          <SourceLine/>
          <SourceLine>// File to be saved</SourceLine>
          <SourceLine>Var ReactorSetupFile As FolderItem = SpecialFolder.Desktop.Child("Reactor Setup.lua")</SourceLine>
          <SourceLine/>
          <SourceLine>// Text file contents</SourceLine>
          <SourceLine>Var LuaScript As String = "--[[" + EndOfLine +_ </SourceLine>
          <SourceLine>"Connect Reactor to Fusion" + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"Setting up Reactor for the first time is a 3 step process." + EndOfLine + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"1. Click the 'Create Script' button. A new 'Reactor Setup.lua' script will be saved to your desktop folder." + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"2. Launch Resolve/Fusion and navigate to the Fusion page." + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"3. Drag the 'Reactor Setup.lua' script from your desktop folder into the Fusion node graph or Console window. A Fusion preference called a PathMap will be configured automatically for Reactor using this script." + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"--]]" + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"print('[Connect Reactor to Fusion]')" + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"-- Set the customized Reactor PathMap" + EndOfLine +_ </SourceLine>
          <SourceLine>"local reactor_root = app:MapPath([[" + ReactorInstallDirectory + "]])" + EndOfLine +_ </SourceLine>
          <SourceLine>"app:SetPrefs([[Global.Paths.Map.Reactor:]], reactor_root)" + EndOfLine +_ </SourceLine>
          <SourceLine>"local userpath = app:GetPrefs([[Global.Paths.Map.UserPaths:]])" + EndOfLine +_ </SourceLine>
          <SourceLine>"if not userpath:find([[Reactor:Deploy]]) then" + EndOfLine +_ </SourceLine>
          <SourceLine>"    userpath = userpath .. [[;Reactor:Deploy]]" + EndOfLine +_ </SourceLine>
          <SourceLine>"    app:SetPrefs([[Global.Paths.Map.UserPaths:]], userpath)" + EndOfLine +_ </SourceLine>
          <SourceLine>"end" + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"-- Add a Reactor:System/Scripts Scripts PathMap entry" + EndOfLine +_ </SourceLine>
          <SourceLine>"local scriptpath = app:GetPrefs([[Global.Paths.Map.Scripts:]])" + EndOfLine +_ </SourceLine>
          <SourceLine>"if not scriptpath:find([[Reactor:System/Scripts]]) then" + EndOfLine +_ </SourceLine>
          <SourceLine>"    scriptpath = scriptpath .. [[;Reactor:System/Scripts]]" + EndOfLine +_ </SourceLine>
          <SourceLine>"    app:SetPrefs([[Global.Paths.Map.Scripts:]], scriptpath)" + EndOfLine +_ </SourceLine>
          <SourceLine>"end" + EndOfLine +_ </SourceLine>
          <SourceLine>"app:SavePrefs()" + EndOfLine +_ </SourceLine>
          <SourceLine>"" + EndOfLine +_ </SourceLine>
          <SourceLine>"print([[[Reactor: PathMap] ']] .. tostring(app:GetPrefs([[Global.Paths.Map.Reactor:]])) .. [[']])" + EndOfLine +_ </SourceLine>
          <SourceLine>"app:DoAction('Console_Show', {Show = True})" + EndOfLine +_ </SourceLine>
          <SourceLine>""</SourceLine>
          <SourceLine/>
          <SourceLine>// Write the text file to disk</SourceLine>
          <SourceLine>Var tos As TextOutputStream</SourceLine>
          <SourceLine>If ReactorSetupFile &lt;&gt; Nil Then</SourceLine>
          <SourceLine>tos = TextOutputStream.Create(ReactorSetupFile)</SourceLine>
          <SourceLine>If tos &lt;&gt; Nil Then</SourceLine>
          <SourceLine>tos.Write(LuaScript)</SourceLine>
          <SourceLine>tos.Close</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Show the desktop folder</SourceLine>
          <SourceLine>//SpecialFolder.Desktop.Launch</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
