 <Method>
  <ItemName>CreateDefaultSettings</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>958185471</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub CreateDefaultSettings()</SourceLine>
   <SourceLine>// Default Preferences</SourceLine>
   <SourceLine>Var json As New JSONItem</SourceLine>
   <SourceLine>json.Compact = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor Standalone Files Location</SourceLine>
   <SourceLine>App.ReactorFolder = SpecialFolder.UserHome.Child("Reactor")</SourceLine>
   <SourceLine>Var ReactorInstallPathMap As String = App.ReactorFolder.NativePath</SourceLine>
   <SourceLine>If ReactorInstallPathMap.Right(1) &lt;&gt; "/" or ReactorInstallPathMap.Right(1) &lt;&gt; "\" Then</SourceLine>
   <SourceLine>// Add the trailing slash</SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>json.Value("ReactorInstallPathMap") = ReactorInstallPathMap + "\"</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>json.Value("ReactorInstallPathMap") = ReactorInstallPathMap + "/"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Gamepad support for Playstation Dualshock controller</SourceLine>
   <SourceLine>json.Value("GamepadSupport") = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Number of days an atom is marked as new</SourceLine>
   <SourceLine>json.Value("NewForDays") = 30</SourceLine>
   <SourceLine>json.Value("MarkAsNew") = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor.json core file</SourceLine>
   <SourceLine>Var jsonReposCore As New JSONItem</SourceLine>
   <SourceLine>jsonReposCore.Value("Name") = "Reactor"</SourceLine>
   <SourceLine>jsonReposCore.Value("Protocol") = "GitLab"</SourceLine>
   <SourceLine>jsonReposCore.Value("LocalFile") = "Reactor.json"</SourceLine>
   <SourceLine>jsonReposCore.Value("BaseURL") = "https://gitlab.com/WeSuckLess/Reactor/-/blob/master/Atoms/"</SourceLine>
   <SourceLine>jsonReposCore.Value("URL") = "https://gitlab.com/WeSuckLess/Reactor/-/raw/master/JSON/Reactor.json?ref_type=heads"</SourceLine>
   <SourceLine>jsonReposCore.Value("ZIPFilePrefix") = "Reactor-master-Atoms-"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Repos</SourceLine>
   <SourceLine>Var jsonRepos As New JSONItem</SourceLine>
   <SourceLine>jsonRepos.Value("_Core") = jsonReposCore</SourceLine>
   <SourceLine>json.Value("Repos") = jsonRepos</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
