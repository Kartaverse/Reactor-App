 <Method>
  <ItemName>SaveSettings</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>110555135</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SaveSettings()</SourceLine>
   <SourceLine>// Save JSON Preferences</SourceLine>
   <SourceLine>Var programName As String = App.ExecutableFile.Name.ReplaceAll(".debug", "") + ".json"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Create the prefs folder</SourceLine>
   <SourceLine>Var prefsFolder As FolderItem = SpecialFolder.ApplicationData.Child("Reactor")</SourceLine>
   <SourceLine>If Not prefsFolder.Exists Then</SourceLine>
   <SourceLine>prefsFolder.CreateFolder</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Show the prefs folder</SourceLine>
   <SourceLine>//prefsFolder.Open()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Read the Window_Prefs.json file from the Moonshot prefs folder</SourceLine>
   <SourceLine>Var prefsFile As FolderItem = prefsFolder.Child(programName)</SourceLine>
   <SourceLine>If prefsFile &lt;&gt; Nil And prefsFolder.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Create the file pointer</SourceLine>
   <SourceLine>Var fileStream As TextOutputStream = TextOutputStream.Create(prefsFile)</SourceLine>
   <SourceLine>If fileStream &lt;&gt; Nil Then</SourceLine>
   <SourceLine>// Create a new JSON object hierarchy</SourceLine>
   <SourceLine>Var json As New JSONItem</SourceLine>
   <SourceLine>json.Compact = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Window Size</SourceLine>
   <SourceLine>Var jsonWindow As New JSONItem</SourceLine>
   <SourceLine>jsonWindow.Value("Top") = ReactorWindow.Top</SourceLine>
   <SourceLine>jsonWindow.Value("Left") = ReactorWindow.Left</SourceLine>
   <SourceLine>jsonWindow.Value("Width") = ReactorWindow.Width</SourceLine>
   <SourceLine>jsonWindow.Value("Height") = ReactorWindow.Height</SourceLine>
   <SourceLine>json.Value("MainWindow") = jsonWindow</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Gamepad support for Playstation Dualshock controller</SourceLine>
   <SourceLine>json.Value("GamepadSupport") = App.GamepadSupport</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Number of days an atom is marked as new</SourceLine>
   <SourceLine>json.Value("NewForDays") = App.NewForDays</SourceLine>
   <SourceLine>json.Value("MarkAsNew") = App.MarkAsNew </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor Install Folder</SourceLine>
   <SourceLine>Var ReactorInstallPathMap As String = App.ReactorFolder.NativePath</SourceLine>
   <SourceLine>If ReactorInstallPathMap.Right(1) &lt;&gt; "/" or ReactorInstallPathMap.Right(1) &lt;&gt; "\" Then</SourceLine>
   <SourceLine>// Add the trailing slash</SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>json.Value("ReactorInstallPathMap") = ReactorInstallPathMap + "\"</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>json.Value("ReactorInstallPathMap") = ReactorInstallPathMap + "/"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor.json core file</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("Repos") Then</SourceLine>
   <SourceLine>Var jsonRepos As JSONItem = App.Settings.Value("Repos")</SourceLine>
   <SourceLine>json.Value("Repos") = jsonRepos</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>System.DebugLog("[Settings Write] No Repository Data Found. Saving fallback repo data.")</SourceLine>
   <SourceLine>// Reactor.json core file</SourceLine>
   <SourceLine>Var jsonReposCore As New JSONItem</SourceLine>
   <SourceLine>jsonReposCore.Value("Name") = "Reactor"</SourceLine>
   <SourceLine>jsonReposCore.Value("Protocol") = "GitLab"</SourceLine>
   <SourceLine>jsonReposCore.Value("LocalFile") = "Reactor.json"</SourceLine>
   <SourceLine>jsonReposCore.Value("BaseURL") = "https://gitlab.com/WeSuckLess/Reactor/-/blob/master/Atoms/"</SourceLine>
   <SourceLine>jsonReposCore.Value("URL") = "https://gitlab.com/WeSuckLess/Reactor/-/raw/master/JSON/Reactor.json?ref_type=heads"</SourceLine>
   <SourceLine>jsonReposCore.Value("ZIPFilePrefix") = "Reactor-master-Atoms-"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Repos</SourceLine>
   <SourceLine>Var jsonRepos As New JSONItem</SourceLine>
   <SourceLine>jsonRepos.Value("_Core") = jsonReposCore</SourceLine>
   <SourceLine>json.Value("Repos") = jsonRepos</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Write the data to disk</SourceLine>
   <SourceLine>fileStream.WriteLine(json.ToString)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Close the filepointer</SourceLine>
   <SourceLine>fileStream.Close</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>// Handle error</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>LoadSettings</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>128329727</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub LoadSettings()</SourceLine>
   <SourceLine>// Load JSON Preferences</SourceLine>
   <SourceLine>Var programName As String = App.ExecutableFile.Name.ReplaceAll(".debug", "") + ".json"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Create the prefs folder</SourceLine>
   <SourceLine>Var prefsFolder As FolderItem = SpecialFolder.ApplicationData.Child("Reactor")</SourceLine>
   <SourceLine>If Not prefsFolder.Exists Then</SourceLine>
   <SourceLine>prefsFolder.CreateFolder</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Read the Window_Prefs.json file from the Moonshot prefs folder</SourceLine>
   <SourceLine>Var prefsFile As FolderItem = prefsFolder.Child(programName)</SourceLine>
   <SourceLine>If prefsFile &lt;&gt; Nil And prefsFile.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Create the file pointer</SourceLine>
   <SourceLine>Var fileStream As TextInputStream = TextInputStream.Open(prefsFile)</SourceLine>
   <SourceLine>If fileStream &lt;&gt; Nil Then</SourceLine>
   <SourceLine>// Read the full text file in one block</SourceLine>
   <SourceLine>Var textData As String = fileStream.ReadAll</SourceLine>
   <SourceLine>// MessageBox(textData)</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>// Create a new JSON object hierarchy</SourceLine>
   <SourceLine>Var json As New JSONItem(textData)</SourceLine>
   <SourceLine>json.Compact = False</SourceLine>
   <SourceLine>Var Val As String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Load the JSON into the settings property</SourceLine>
   <SourceLine>App.Settings = json</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// MessageBox(json.ToString)</SourceLine>
   <SourceLine>System.DebugLog("[Settings Read]")</SourceLine>
   <SourceLine>System.DebugLog(json.ToString)</SourceLine>
   <SourceLine>Catch error As JSONException</SourceLine>
   <SourceLine>// Fallback Resolution</SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>// Fallback</SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>// Handle IO error</SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>App.GamepadSupport = 0</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>Catch error As JSONException</SourceLine>
   <SourceLine>// Fallback </SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>App.GamepadSupport = 0</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>// Fallback</SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>App.GamepadSupport = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Check if the settings exist</SourceLine>
   <SourceLine>If App.Settings = Nil Then</SourceLine>
   <SourceLine>CreateDefaultSettings()</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Gamepad support</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("GamepadSupport") Then</SourceLine>
   <SourceLine>Var Val As String = App.Settings.Value("GamepadSupport")</SourceLine>
   <SourceLine>App.GamepadSupport = Val.ToInteger</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Number of days an atom is marked as new</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("NewForDays") Then</SourceLine>
   <SourceLine>App.NewForDays = App.Settings.Value("NewForDays")</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>App.NewForDays = 30</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("MarkAsNew") Then</SourceLine>
   <SourceLine>App.MarkAsNew = App.Settings.Value("MarkAsNew")</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>App.MarkAsNew = True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Reactor Standalone Files Location</SourceLine>
   <SourceLine>// Todo: Possibly read the env variable for "ReactorInstallPathMap" to allow it to override the prefs file</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("ReactorInstallPathMap") Then</SourceLine>
   <SourceLine>Var Val As String = App.Settings.Value("ReactorInstallPathMap")</SourceLine>
   <SourceLine>Var ReactorFolderItem As FolderItem = New FolderItem(Val)</SourceLine>
   <SourceLine>App.ReactorFolder = ReactorFolderItem </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Create the intermediate sub-directories for the Reactor folder</SourceLine>
