 <Method>
  <ItemName>JSONDownload</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>348532735</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub JSONDownload()</SourceLine>
   <SourceLine>// Download the JSON file</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Load the Reactor.json _Core Repo URL</SourceLine>
   <SourceLine>Var url As String = ""</SourceLine>
   <SourceLine>Var filename As String = ""</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("Repos") Then</SourceLine>
   <SourceLine>Var jsonRepos As JSONItem = App.Settings.Value("Repos")</SourceLine>
   <SourceLine>If jsonRepos.HasKey("_Core") Then</SourceLine>
   <SourceLine>Var jsonReposCore As JSONItem =  jsonRepos.Value("_Core")</SourceLine>
   <SourceLine>If jsonReposCore.HasKey("URL") Then</SourceLine>
   <SourceLine>url = jsonReposCore.Value("URL")</SourceLine>
   <SourceLine>// MessageBox(url)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If jsonReposCore.HasKey("LocalFile") Then</SourceLine>
   <SourceLine>filename = jsonReposCore.Value("LocalFile")</SourceLine>
   <SourceLine>// MessageBox(filename)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>// Fallback URL</SourceLine>
   <SourceLine>If url = "" Then</SourceLine>
   <SourceLine>url = "https://gitlab.com/WeSuckLess/Reactor/-/raw/master/JSON/Reactor.json?ref_type=heads"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If filename = "" Then</SourceLine>
   <SourceLine>filename = "Reactor.json"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.CreateSubFolders(App.JSONFolder)</SourceLine>
   <SourceLine>Var JSONFile As FolderItem = App.CreateNewFolder(App.JSONFolder).Child(filename)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Rebuild the Reactor folder hiearchy</SourceLine>
   <SourceLine>App.CreateReactorFolders()</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Socket header data</SourceLine>
   <SourceLine>RSocket.ClearRequestHeaders</SourceLine>
   <SourceLine>RSocket.RequestHeader("User-Agent") = "Xojo"</SourceLine>
   <SourceLine>RSocket.AllowCertificateValidation = false</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Show a label with the Reactor.json filename</SourceLine>
   <SourceLine>App.DownloadFilename = filename</SourceLine>
   <SourceLine>App.DownloadAtomID = ""</SourceLine>
   <SourceLine>App.DownloadName = ""</SourceLine>
   <SourceLine>App.DownloadFolderItem = JSONFile</SourceLine>
   <SourceLine>App.Atoms = New JSONItem(RSocket.SendSync("GET", url, 15))</SourceLine>
   <SourceLine>DownloadStatsLabel.Text = App.DownloadFilename + " " + "100% "</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var options As New JSONOptions</SourceLine>
   <SourceLine>options.Compact = False</SourceLine>
   <SourceLine>options.IndentSpacing = 4</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var tos As TextOutputStream</SourceLine>
   <SourceLine>If JSONFile &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos = TextOutputStream.Create(JSONFile)</SourceLine>
   <SourceLine>If tos &lt;&gt; Nil and App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos.Write(App.Atoms.ToString(options))</SourceLine>
   <SourceLine>tos.Close</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>DownloadStatsLabel.Text = ""</SourceLine>
   <SourceLine>DownloadProgress.Value = 0</SourceLine>
   <SourceLine>DownloadProgress.Visible = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
