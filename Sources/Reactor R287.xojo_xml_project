 <Method>
  <ItemName>AtomIncompatible</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>217421823</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AtomIncompatible(InstalledAtomID As String) As Boolean</SourceLine>
   <SourceLine>// Fix this to flag atoms that are yet to be installed</SourceLine>
   <SourceLine>Var DeployAtomsFile As FolderItem = App.DeployAtomsReactorFolder.Child(InstalledAtomID + ".atom")</SourceLine>
   <SourceLine>Var DeployJSONFile As FolderItem = App.DeployJSONReactorFolder.Child(InstalledAtomID + ".json")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var AtomExists As Integer = 0</SourceLine>
   <SourceLine>Var IncompatibleAtom As Integer = 0</SourceLine>
   <SourceLine>Var CheckAtom As New JSONItem</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If DeployJSONFile &lt;&gt; Nil and DeployJSONFile.Exists Then</SourceLine>
   <SourceLine>// JSON file exists (Reactor.app install)</SourceLine>
   <SourceLine>AtomExists = 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Read the JSON file to disk</SourceLine>
   <SourceLine>Var tos As TextInputStream</SourceLine>
   <SourceLine>If DeployJSONFile &lt;&gt; Nil Then</SourceLine>
   <SourceLine>tos = TextInputStream.Open(DeployJSONFile)</SourceLine>
   <SourceLine>if tos &lt;&gt; Nil Then</SourceLine>
   <SourceLine>CheckAtom.Load(tos.ReadAll())</SourceLine>
   <SourceLine>tos.Close</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>If App.Atoms &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As String In App.Atoms.Keys</SourceLine>
   <SourceLine>Var Atom As JSONItem = App.Atoms.Value(k)</SourceLine>
   <SourceLine>Var AtomCategory As String = Atom.Value("Category")</SourceLine>
   <SourceLine>Var AtomID As String = Atom.Value("ID")</SourceLine>
   <SourceLine>If AtomID = InstalledAtomID Then</SourceLine>
   <SourceLine>CheckAtom = Atom</SourceLine>
   <SourceLine>Exit For k // or Return if inside method</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Parse the atom file</SourceLine>
   <SourceLine>If CheckAtom &lt;&gt; Nil Then</SourceLine>
   <SourceLine>Var AtomID As String = CheckAtom.Value("ID")</SourceLine>
   <SourceLine>// See if the atoms are the same</SourceLine>
   <SourceLine>If InstalledAtomID = AtomID Then</SourceLine>
   <SourceLine>// Min/max Version</SourceLine>
   <SourceLine>// OS match</SourceLine>
   <SourceLine>// IncompatibleAtom = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TargetWindows Then</SourceLine>
   <SourceLine>' Running on Windows</SourceLine>
   <SourceLine>If AtomID = "com.wesuckless.NotWindows" Then</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf TargetMacOS Then</SourceLine>
   <SourceLine>' Running on macOS</SourceLine>
   <SourceLine>If AtomID  = "com.wesuckless.WindowsOnly" Then</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf TargetLinux And TargetARM Then</SourceLine>
   <SourceLine>' Running on Raspberry Pi</SourceLine>
   <SourceLine>If AtomID  = "com.wesuckless.WindowsOnly" Then</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf TargetLinux Then</SourceLine>
   <SourceLine>' Running on Linux</SourceLine>
   <SourceLine>If AtomID  = "com.wesuckless.WindowsOnly" Then</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf TargetiOS Then</SourceLine>
   <SourceLine>' Running on iOS</SourceLine>
   <SourceLine>If AtomID  = "com.wesuckless.WindowsOnly" Then</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>InstalledAtomID As String</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
 <Method>
  <ItemName>CreateParentSubFolders</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1648504831</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub CreateParentSubFolders(Path_FolderItem As FolderItem)</SourceLine>
   <SourceLine>// CreateParentSubFolders - Accepts a file based filepath and creates the intermediate sub-folders</SourceLine>
   <SourceLine>If Path_FolderItem &lt;&gt; Nil Then</SourceLine>
   <SourceLine>Var Path As String = Path_FolderItem.Parent.NativePath</SourceLine>
   <SourceLine>If Path &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Var Path As String = "/Users/vfx/Reactor/Deploy/Atoms/Reactor/"</SourceLine>
   <SourceLine>// System.DebugLog(Path)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TargetMacOS or TargetLinux Then</SourceLine>
   <SourceLine>// macOS or Linux platform</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Normalize the file slashes to Unix style</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("\", "/")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// De-duplicate any doubled up slashesh</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("//", "/")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Use Unix style slashes when building filepath strings</SourceLine>
   <SourceLine>Var Separator As String = "/"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var New_Path As String = ""</SourceLine>
   <SourceLine>Var Path_Segments() As String = Path.Split(Separator)</SourceLine>
   <SourceLine>For Each p As String In Path_Segments</SourceLine>
   <SourceLine>// Check for empty segments</SourceLine>
   <SourceLine>If p &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Append the sub-folders starting at the base directory</SourceLine>
   <SourceLine>New_Path = New_Path + Separator + p</SourceLine>
   <SourceLine>Var FileDest As FolderItem =  New FolderItem(New_Path)</SourceLine>
   <SourceLine>If not FileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>FileDest.CreateFolder()</SourceLine>
   <SourceLine>//System.DebugLog("""" + FileDest.NativePath + """" + EndOfLine)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>ElseIf TargetWindows Then</SourceLine>
   <SourceLine>// Win Platform</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Normalize the file slashes to Unix style</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("/", "\")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// De-duplicate any doubled up slashesh</SourceLine>
   <SourceLine>// Path = Path.ReplaceAll("\\", "\")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Use Windows style slashes when building filepath strings</SourceLine>
   <SourceLine>Var Separator As String = "\"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var New_Path As String = ""</SourceLine>
   <SourceLine>Var Path_Segments() As String = Path.Split(Separator)</SourceLine>
   <SourceLine>Var Path_Count As Integer = 0</SourceLine>
   <SourceLine>For Each p As String In Path_Segments</SourceLine>
   <SourceLine>// Check for empty segments</SourceLine>
   <SourceLine>System.DebugLog(p)</SourceLine>
   <SourceLine>If p &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Append the sub-folders starting at the base directory</SourceLine>
   <SourceLine>If Path_Count = 0 then</SourceLine>
   <SourceLine>New_Path = p</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>New_Path = New_Path + Separator + p</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Path_Count = Path_Count + 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var FileDest As FolderItem = New FolderItem(New_Path)</SourceLine>
   <SourceLine>If not FileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>FileDest.CreateFolder()</SourceLine>
   <SourceLine>//System.DebugLog("""" + FileDest.NativePath + """" + EndOfLine)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>Path_FolderItem As FolderItem</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>HTMLDeployFilesList</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1291470847</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function HTMLDeployFilesList(Atom As JSONItem) As String</SourceLine>
   <SourceLine>Var AtomID As String =  Atom.Value("ID")</SourceLine>
   <SourceLine>Var HTML As String = ""</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Atom.HasKey("Deploy") Then</SourceLine>
   <SourceLine>Var AtomDeploy As JSONItem = Atom.Value("Deploy")</SourceLine>
   <SourceLine>HTML = "&lt;p&gt;Installed Files:&lt;ul&gt;" + EndOfLine</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//&lt;li&gt; + str(file) + "&lt;/a&gt;&lt;/li&gt;\</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Load the Reactor.json _Core Repo URL</SourceLine>
   <SourceLine>Var baseURL As String = ""</SourceLine>
   <SourceLine>If App.Settings &lt;&gt; Nil and App.Settings.HasKey("Repos") Then</SourceLine>
   <SourceLine>Var jsonRepos As JSONItem = App.Settings.Value("Repos")</SourceLine>
   <SourceLine>If jsonRepos.HasKey("_Core") Then</SourceLine>
   <SourceLine>Var jsonReposCore As JSONItem =  jsonRepos.Value("_Core")</SourceLine>
   <SourceLine>If jsonReposCore.HasKey("BaseURL") Then</SourceLine>
   <SourceLine>baseURL = jsonReposCore.Value("BaseURL")</SourceLine>
   <SourceLine>//MessageBox(URL)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>// Fallback URL</SourceLine>
   <SourceLine>If baseURL = "" Then</SourceLine>
   <SourceLine>baseURL = "https://gitlab.com/WeSuckLess/Reactor/-/blob/master/Atoms/"</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Deploy files</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>If AtomDeploy.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As String In AtomDeploy.Keys</SourceLine>
   <SourceLine>if k &lt;&gt; "Mac" and k &lt;&gt; "Windows" and k &lt;&gt; "Linux" Then</SourceLine>
   <SourceLine>// Common Files</SourceLine>
   <SourceLine>Var DeployVariant As Variant = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>HTML = HTML +"&lt;li&gt;&amp;nbsp;&amp;nbsp;&lt;a style=""color: #C7C7C7; text-decoration: underline;"" href=""" + baseURL + AtomID + "/" + DeployVariant.StringValue + "?ref_type=heads""&gt;" + DeployVariant.StringValue + "&lt;/a&gt;&lt;/li&gt;" + EndOfLine</SourceLine>
   <SourceLine>ElseIf k = "Mac" and TargetMacOS Then</SourceLine>
   <SourceLine>// macOS Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>HTML = HTML +"&lt;li&gt;&amp;nbsp;&amp;nbsp;&lt;a style=""color: #C7C7C7; text-decoration: underline;"" href=""" + baseURL + AtomID + "/Mac/" + DeployOSVariant.StringValue + "?ref_type=heads""&gt;" + DeployOSVariant.StringValue + "&lt;/a&gt;&lt;/li&gt;" + EndOfLine</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Windows" and TargetWindows Then</SourceLine>
   <SourceLine>// Windows Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>HTML = HTML +"&lt;li&gt;&amp;nbsp;&amp;nbsp;&lt;a style=""color: #C7C7C7; text-decoration: underline;"" href=""" + baseURL + AtomID + "/Windows/" + DeployOSVariant.StringValue + "?ref_type=heads""&gt;" + DeployOSVariant.StringValue + "&lt;/a&gt;&lt;/li&gt;" + EndOfLine</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf k = "Linux" and TargetLinux Then</SourceLine>
   <SourceLine>// Linux Files</SourceLine>
   <SourceLine>Var AtomDeployOS As JSONItem = AtomDeploy.Value(k)</SourceLine>
   <SourceLine>If AtomDeployOS.Keys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each j As String In AtomDeployOS.Keys</SourceLine>
   <SourceLine>Var DeployOSVariant As Variant = AtomDeployOS.Value(j)</SourceLine>
   <SourceLine>HTML = HTML +"&lt;li&gt;&amp;nbsp;&amp;nbsp;&lt;a style=""color: #C7C7C7; text-decoration: underline;"" href=""" + baseURL + AtomID + "/Linux/" + DeployOSVariant.StringValue + "?ref_type=heads""&gt;" + DeployOSVariant.StringValue + "&lt;/a&gt;&lt;/li&gt;" + EndOfLine</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>HTML = HTML + "&lt;/ul&gt;&lt;/p&gt;" + EndOfLine</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return HTML</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
