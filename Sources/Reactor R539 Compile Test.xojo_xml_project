      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub RefreshHighlights(Index As Integer)</SourceLine>
        <SourceLine>System.DebugLog("[Highlights] " + App.Highlights.Count.ToString)</SourceLine>
        <SourceLine>System.DebugLog(App.Highlights.ToString())</SourceLine>
        <SourceLine/>
        <SourceLine>// Clamp to active range</SourceLine>
        <SourceLine>Var i As Integer = Index</SourceLine>
        <SourceLine>if i &gt; App.Highlights.Count Then</SourceLine>
        <SourceLine>// Clamp the high bounds</SourceLine>
        <SourceLine>i = App.Highlights.Count</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Track the active Highlights page</SourceLine>
        <SourceLine>App.HighlightsIndex = i</SourceLine>
        <SourceLine/>
        <SourceLine>// Toggle the bullet icon visibility</SourceLine>
        <SourceLine>If App.Highlights.Count = 0 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 1 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 2 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = False</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 3 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = False</SourceLine>
        <SourceLine>ElseIf App.Highlights.Count = 4 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Visible = True</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Visible = True</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Toggle the bullet icon state</SourceLine>
        <SourceLine>If i = 1 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 2 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 3 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>ElseIf i = 4 Then</SourceLine>
        <SourceLine>HighlightTopBulletCanvas1.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas2.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas3.Backdrop = PromoBulletOff</SourceLine>
        <SourceLine>HighlightTopBulletCanvas4.Backdrop = PromoBulletOn</SourceLine>
        <SourceLine>End</SourceLine>
        <SourceLine/>
        <SourceLine>// Fill in the data fields</SourceLine>
        <SourceLine>If App.Highlights &lt;&gt; Nil and i &gt;= 1 Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>Var HighlightItem As JSONItem = App.Highlights.Value(i.ToString)</SourceLine>
        <SourceLine>If HighlightItem &lt;&gt; Nil Then</SourceLine>
        <SourceLine>// Validate the elements exist</SourceLine>
        <SourceLine>If HighlightItem.HasKey("Title") Then</SourceLine>
        <SourceLine>Var Title As String = HighlightItem.Value("Title")</SourceLine>
        <SourceLine>TitleLabel.Visible = True</SourceLine>
        <SourceLine>TitleLabel.Text = Title</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>TitleLabel.Visible = False</SourceLine>
        <SourceLine>TitleLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If HighlightItem.HasKey("Blurb") Then</SourceLine>
        <SourceLine>Var Blurb As String = HighlightItem.Value("Blurb")</SourceLine>
        <SourceLine>AboutLabel.Visible = True</SourceLine>
        <SourceLine>AboutLabel.Text = Blurb</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>AboutLabel.Visible = False</SourceLine>
        <SourceLine>AboutLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If HighlightItem.HasKey("AtomName") Then</SourceLine>
        <SourceLine>Var AtomName As String = HighlightItem.Value("AtomName")</SourceLine>
        <SourceLine>HighlightTopMagnifyCanvas1.Visible = True</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Visible = True</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Visible = True</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Text =  "Show"</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Text = AtomName + "  Package"</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>HighlightTopMagnifyCanvas1.Visible = False</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Visible = False</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Text =  ""</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Note: Processing the AtomID should be done on the MouseDown event of that element</SourceLine>
        <SourceLine>// If HighlightItem.HasKey("AtomID") Then</SourceLine>
        <SourceLine>// Var AtomID As String = HighlightItem.Value("AtomID")</SourceLine>
        <SourceLine>// If AtomID = "AboutReactor" Then</SourceLine>
        <SourceLine>// AboutWindow.Show = True</SourceLine>
        <SourceLine>// Else</SourceLine>
        <SourceLine>// // Any other atom link</SourceLine>
        <SourceLine>// End If</SourceLine>
        <SourceLine>// End If</SourceLine>
        <SourceLine/>
        <SourceLine>If HighlightItem.HasKey("ShowRelatedName") Then</SourceLine>
        <SourceLine>Var ShowRelatedName As String = HighlightItem.Value("ShowRelatedName")</SourceLine>
        <SourceLine>HighlightTopMagnifyCanvas2.Visible = True</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Visible = True</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Text = "Show " + ShowRelatedName</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>HighlightTopMagnifyCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>If HighlightItem.HasKey("DiscussName") Then</SourceLine>
        <SourceLine>Var DiscussName As String = HighlightItem.Value("DiscussName")</SourceLine>
        <SourceLine>HighlightTopExternalLinkCanvas.Visible = True</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Visible = True</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Text = DiscussName</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>HighlightTopExternalLinkCanvas.Visible = False</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Load the image element</SourceLine>
        <SourceLine>If HighlightItem.HasKey("ImageURL") Then</SourceLine>
        <SourceLine>Var url As String = HighlightItem.Value("ImageURL")</SourceLine>
        <SourceLine/>
        <SourceLine>// Socket header data</SourceLine>
        <SourceLine>RSocket.ClearRequestHeaders</SourceLine>
        <SourceLine>RSocket.RequestHeader("User-Agent") = "Xojo"</SourceLine>
        <SourceLine>RSocket.AllowCertificateValidation = false</SourceLine>
        <SourceLine/>
        <SourceLine>Var Response As MemoryBlock = RSocket.SendSync("GET", url, 15)</SourceLine>
        <SourceLine>If RSocket.HTTPStatusCode = 200 Then</SourceLine>
        <SourceLine>// Image loaded OK</SourceLine>
        <SourceLine>Dim ImageThumbnail As Picture =Picture.FromData(Response)</SourceLine>
        <SourceLine>HighlightThumbnailCanvas.Backdrop = ImageThumbnail</SourceLine>
        <SourceLine>DownloadStatsLabel.Text = "Highlight Image Downloaded"</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback image</SourceLine>
        <SourceLine>HighlightThumbnailCanvas.Backdrop = SnazzyPatternFlip</SourceLine>
        <SourceLine>System.DebugLog("Highlight Image Network Error: " + Str(RSocket.HTTPStatusCode))</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As UnsupportedFormatException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As JSONException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As KeyNotFoundException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// No content found</SourceLine>
        <SourceLine>TitleLabel.Visible = False</SourceLine>
        <SourceLine>TitleLabel.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>AboutLabel.Visible = False</SourceLine>
        <SourceLine>AboutLabel.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>HighlightTopMagnifyCanvas1.Visible = False</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Visible = False</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightShowTextLabel1.Text =  ""</SourceLine>
        <SourceLine>HighlightShowAtomTextLabel.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>HighlightTopMagnifyCanvas2.Visible = False</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightShowRelatedNameTextLabel.Text = ""</SourceLine>
        <SourceLine/>
        <SourceLine>HighlightTopExternalLinkCanvas.Visible = False</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Visible = False</SourceLine>
        <SourceLine>HighlightDiscussItemTextLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>// Show what is coming up next</SourceLine>
        <SourceLine>Var j as Integer = i + 1</SourceLine>
        <SourceLine>if  App.Highlights.Count &gt;= 1 and j &gt; App.Highlights.Count Then</SourceLine>
        <SourceLine>// wrap around the high bounds</SourceLine>
        <SourceLine>j = 1</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>If App.Highlights &lt;&gt; Nil and j &gt;= 1 Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>Var HighlightItem As JSONItem = App.Highlights.Value(j.ToString)</SourceLine>
        <SourceLine>If HighlightItem &lt;&gt; Nil Then</SourceLine>
        <SourceLine/>
        <SourceLine>// Validate the elements exist</SourceLine>
        <SourceLine>If HighlightItem.HasKey("Title") Then</SourceLine>
        <SourceLine>Var Title As String = HighlightItem.Value("Title")</SourceLine>
        <SourceLine>HighlightNextTextLabel.Text = Title</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>TitleLabel.Text = ""</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch error As IOException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As UnsupportedFormatException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As JSONException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>Catch error As KeyNotFoundException</SourceLine>
        <SourceLine>//</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
