        </ItemSource>
      </HookInstance>
      <HookInstance>
        <ItemName>PaintCellText</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1413482495</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Function PaintCellText(g as Graphics, row as Integer, column as Integer, x as Integer, y as Integer) As Boolean</SourceLine>
          <SourceLine>// Clear the canvas</SourceLine>
          <SourceLine>g.ClearRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt ListBox Grey BG</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(30, 30, 30)</SourceLine>
          <SourceLine>g.FillRectangle(0, 0, g.Width, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Dark Grey Outline Stroke</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(21, 21, 21)</SourceLine>
          <SourceLine>g.DrawLine(g.Width - 1, 0, g.Width - 1, g.Height)</SourceLine>
          <SourceLine/>
          <SourceLine>// Item Count Number</SourceLine>
          <SourceLine>Var ItemCount As Integer = 0</SourceLine>
          <SourceLine/>
          <SourceLine>// Var CategoryRow As Integer = CategoryListbox.SelectedRowIndex</SourceLine>
          <SourceLine>// If CategoryRow &gt;= 0 Then</SourceLine>
          <SourceLine/>
          <SourceLine>Var StateRow As Integer = StateListBox.SelectedRowIndex</SourceLine>
          <SourceLine>Var SelectedState As String = StateListBox.CellTextAt(StateRow, 0)</SourceLine>
          <SourceLine>Select Case SelectedState</SourceLine>
          <SourceLine>Case "Any State"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>Case "Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>Case "Not Installed"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>Case "Dependencies"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>Case "Donate"</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>Case "Incompatible"</SourceLine>
          <SourceLine>// JustCropIt Neon Pink</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 60, 107)</SourceLine>
          <SourceLine>Case "New"</SourceLine>
          <SourceLine>// JustCropIt Neon Green</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(154, 233, 60)</SourceLine>
          <SourceLine>Case "Update"</SourceLine>
          <SourceLine>// JustCropIt Purple</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(193,135, 248)</SourceLine>
          <SourceLine>Case "Downloading"</SourceLine>
          <SourceLine>// JustCropIt Cyan</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(119, 227, 252)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Medium Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(80, 80, 80)</SourceLine>
          <SourceLine>End Select</SourceLine>
          <SourceLine/>
          <SourceLine>// Draw the package count number</SourceLine>
          <SourceLine>If row &gt;= 0 Then</SourceLine>
          <SourceLine>Var RowText As String = Me.CellTextAt(row, 0)</SourceLine>
          <SourceLine>If App.JSONCategoryCount &lt;&gt; Nil and App.JSONCategoryCount.HasKey(RowText) Then</SourceLine>
          <SourceLine>ItemCount = App.JSONCategoryCount.Value(RowText)</SourceLine>
          <SourceLine>If ItemCount &gt;= 1 Then</SourceLine>
          <SourceLine>g.DrawText(ItemCount.ToString(), g.width - 30, y, g.width, True)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>If Me.SelectedRowIndex = row Then</SourceLine>
          <SourceLine>// Enable Bold Text</SourceLine>
          <SourceLine>g.Bold = True</SourceLine>
          <SourceLine/>
          <SourceLine>If color.IsDarkMode Then</SourceLine>
          <SourceLine>// JustCropIt Yellow</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 206, 30)</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// JustCropIt Yellow</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(251, 206, 30)</SourceLine>
          <SourceLine>// JustCropIt Light Grey</SourceLine>
          <SourceLine>// g.DrawingColor = Color.RGB(155, 155, 155)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Disable Bold Text</SourceLine>
          <SourceLine>g.Bold = False</SourceLine>
          <SourceLine/>
          <SourceLine>// JustCropIt Light Grey</SourceLine>
          <SourceLine>g.DrawingColor = Color.RGB(155, 155, 155)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Highlight shape</SourceLine>
          <SourceLine>If row = Me.SelectedRowIndex Then</SourceLine>
          <SourceLine>// Hexagon Bullet</SourceLine>
          <SourceLine>g.DrawPicture(BulletOn, -2, 1)</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>End Function</SourceLine>
        </ItemSource>
      </HookInstance>
    </ControlBehavior>
