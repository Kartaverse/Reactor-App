  <HookInstance>
   <ItemName>ValueChanged</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>507199487</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub ValueChanged()</SourceLine>
    <SourceLine>// Gamepad support</SourceLine>
    <SourceLine>If Me.VisualState = DesktopCheckBox.VisualStates.Checked Then</SourceLine>
    <SourceLine>App.GamepadSupport = 1</SourceLine>
    <SourceLine>ReactorWindow.InputDevicesTimer.Enabled = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.GamepadSupport = 0</SourceLine>
    <SourceLine>ReactorWindow.InputDevicesTimer.Enabled = False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
 </ControlBehavior>
 <ControlBehavior>
  <Superclass>DesktopButton</Superclass>
  <HookInstance>
   <ItemName>Pressed</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>2016927743</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Pressed()</SourceLine>
    <SourceLine>// Gamepad support</SourceLine>
    <SourceLine>If GamepadSupportCheckbox.VisualState = DesktopCheckBox.VisualStates.Checked Then</SourceLine>
    <SourceLine>App.GamepadSupport = 1</SourceLine>
    <SourceLine>ReactorWindow.InputDevicesTimer.Enabled = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.GamepadSupport = 0</SourceLine>
    <SourceLine>ReactorWindow.InputDevicesTimer.Enabled = False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Number of days an atom is marked as new</SourceLine>
    <SourceLine>Var prevNewForDays As Integer = App.NewForDays</SourceLine>
    <SourceLine>App.NewForDays = NewAtomsDaysTextField.Text.ToInteger</SourceLine>
    <SourceLine>If NewAtomsCheckbox.VisualState = DesktopCheckBox.VisualStates.Checked Then</SourceLine>
    <SourceLine>App.MarkAsNew = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.MarkAsNew = False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Custom Install Path</SourceLine>
    <SourceLine>Var prevReactorFolder As Folderitem = App.ReactorFolder</SourceLine>
    <SourceLine>If PathMapSegmentedButton.SelectedSegmentIndex = 0 Then</SourceLine>
    <SourceLine>// Home</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.UserHome.Child("Reactor")</SourceLine>
    <SourceLine>ElseIf PathMapSegmentedButton.SelectedSegmentIndex = 1 Then</SourceLine>
    <SourceLine>// Documents</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.Documents.Child("Reactor")</SourceLine>
    <SourceLine>ElseIf PathMapSegmentedButton.SelectedSegmentIndex = 2 Then</SourceLine>
    <SourceLine>// Resolve Prefs</SourceLine>
    <SourceLine>If TargetWindows Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// C:\ProgramData\Blackmagic Design\DaVinci Resolve\Fusion\Reactor\</SourceLine>
    <SourceLine>ElseIf TargetMacOS Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// /Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Reactor/</SourceLine>
    <SourceLine>ElseIf TargetLinux Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.Variable.Child("Blackmagic Design").Child("DaVinci Resolve").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// /var/BlackmagicDesign/DaVinci Resolve/Fusion/Reactor/</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf PathMapSegmentedButton.SelectedSegmentIndex = 3 Then</SourceLine>
    <SourceLine>// Fusion Prefs</SourceLine>
    <SourceLine>If TargetWindows Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// C:\ProgramData\Blackmagic Design\Fusion\Reactor\</SourceLine>
    <SourceLine>ElseIf TargetMacOS Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.SharedApplicationData.Child("Blackmagic Design").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// /Library/Application Support/Blackmagic Design/Fusion/Reactor/</SourceLine>
    <SourceLine>ElseIf TargetLinux Then</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.Variable.Child("Blackmagic Design").Child("Fusion").Child("Reactor")</SourceLine>
    <SourceLine>// /var/BlackmagicDesign/Fusion/Reactor/</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf PathMapSegmentedButton.SelectedSegmentIndex = 4 Then</SourceLine>
    <SourceLine>// Custom</SourceLine>
    <SourceLine>App.ReactorFolder = New FolderItem(ReactorPathTextField.Text)</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>// Home</SourceLine>
    <SourceLine>App.ReactorFolder = SpecialFolder.UserHome.Child("Reactor")</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Update the GUI Text String</SourceLine>
    <SourceLine>Var ReactorInstallPathMap As String = App.ReactorFolder.NativePath</SourceLine>
    <SourceLine>If ReactorInstallPathMap.Right(1) &lt;&gt; "/" or ReactorInstallPathMap.Right(1) &lt;&gt; "\" Then</SourceLine>
    <SourceLine>// Add the trailing slash</SourceLine>
    <SourceLine>If TargetWindows Then</SourceLine>
    <SourceLine>ReactorPathTextField.Text = ReactorInstallPathMap + "\"</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>ReactorPathTextField.Text = ReactorInstallPathMap + "/"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Refresh things on a Reactor folder path change</SourceLine>
    <SourceLine>If prevReactorFolder.NativePath &lt;&gt; App.ReactorFolder.NativePath or prevNewForDays &lt;&gt; App.NewForDays Then</SourceLine>
    <SourceLine>// Create the intermediate sub-directories for the Reactor folder</SourceLine>
    <SourceLine>App.CreateSubFolders(App.ReactorFolder)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Rebuild the prefs</SourceLine>
    <SourceLine>App.SaveSettings()</SourceLine>
    <SourceLine>App.LoadSettings()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Download the Reactor.json file</SourceLine>
    <SourceLine>ReactorWindow.JSONDownload()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>// Update the listboxes</SourceLine>
    <SourceLine>ReactorWindow.CategoryRefresh()</SourceLine>
    <SourceLine>ReactorWindow.AtomsRefresh()</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>PreferencesWindow.Hide()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
 </ControlBehavior>
