 <Method>
  <ItemName>Format</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1728921599</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function Format() As Text</SourceLine>
   <SourceLine>For Each c As Text In JSONText.Characters</SourceLine>
   <SourceLine>Escaped = IsEscaped(c)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If IsQuote(c) Then</SourceLine>
   <SourceLine>Quoted = Not Quoted</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Not Quoted And IsOpenBracket(c) Then</SourceLine>
   <SourceLine>WriteCurrentLine</SourceLine>
   <SourceLine>AddCharToLine(c)</SourceLine>
   <SourceLine>WriteCurrentLine</SourceLine>
   <SourceLine>Indent</SourceLine>
   <SourceLine>ElseIf Not Quoted And IsCloseBracket(c) Then</SourceLine>
   <SourceLine>WriteCurrentLine</SourceLine>
   <SourceLine>UnIndent</SourceLine>
   <SourceLine>AddCharToLine(c)</SourceLine>
   <SourceLine>ElseIf Not Quoted And IsComma(c) Then</SourceLine>
   <SourceLine>AddCharToLine(c)</SourceLine>
   <SourceLine>WriteCurrentLine</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>AddCharToLine(c)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>WriteCurrentLine</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return FormattedJSON</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult>Text</ItemResult>
 </Method>
