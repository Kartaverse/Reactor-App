  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub CreateParentSubFolders(Path_FolderItem As FolderItem)</SourceLine>
   <SourceLine>// CreateParentSubFolders - Accepts a file based filepath and creates the intermediate sub-folders</SourceLine>
   <SourceLine>If Path_FolderItem &lt;&gt; Nil Then</SourceLine>
   <SourceLine>Var Path As String = Path_FolderItem.Parent.NativePath</SourceLine>
   <SourceLine>If Path &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Var Path As String = "/Users/vfx/Reactor/Deploy/Atoms/Reactor/"</SourceLine>
   <SourceLine>// System.DebugLog(Path)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TargetMacOS or TargetLinux Then</SourceLine>
   <SourceLine>// macOS or Linux platform</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Normalize the file slashes to Unix style</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("\", "/")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// De-duplicate any doubled up slashesh</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("//", "/")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Use Unix style slashes when building filepath strings</SourceLine>
   <SourceLine>Var Separator As String = "/"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var New_Path As String = ""</SourceLine>
   <SourceLine>Var Path_Segments() As String = Path.Split(Separator)</SourceLine>
   <SourceLine>For Each p As String In Path_Segments</SourceLine>
   <SourceLine>// Check for empty segments</SourceLine>
   <SourceLine>If p &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Append the sub-folders starting at the base directory</SourceLine>
   <SourceLine>New_Path = New_Path + Separator + p</SourceLine>
   <SourceLine>Var FileDest As FolderItem = New FolderItem(New_Path)</SourceLine>
   <SourceLine>If not FileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>FileDest.CreateFolder()</SourceLine>
   <SourceLine>//System.DebugLog("""" + FileDest.NativePath + """" + EndOfLine)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>ElseIf TargetWindows Then</SourceLine>
   <SourceLine>// Win Platform</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Normalize the file slashes to Unix style</SourceLine>
   <SourceLine>Path = Path.ReplaceAll("/", "\")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// De-duplicate any doubled up slashesh</SourceLine>
   <SourceLine>// Path = Path.ReplaceAll("\\", "\")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Use Windows style slashes when building filepath strings</SourceLine>
   <SourceLine>Var Separator As String = "\"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var New_Path As String = ""</SourceLine>
   <SourceLine>Var Path_Segments() As String = Path.Split(Separator)</SourceLine>
   <SourceLine>Var Path_Count As Integer = 0</SourceLine>
   <SourceLine>For Each p As String In Path_Segments</SourceLine>
   <SourceLine>// Check for empty segments</SourceLine>
   <SourceLine>System.DebugLog(p)</SourceLine>
   <SourceLine>If p &lt;&gt; "" Then</SourceLine>
   <SourceLine>// Append the sub-folders starting at the base directory</SourceLine>
   <SourceLine>If Path_Count = 0 then</SourceLine>
   <SourceLine>New_Path = p</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>New_Path = New_Path + Separator + p</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Path_Count = Path_Count + 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var FileDest As FolderItem = New FolderItem(New_Path)</SourceLine>
   <SourceLine>If not FileDest.Exists Then</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>FileDest.CreateFolder()</SourceLine>
   <SourceLine>//System.DebugLog("""" + FileDest.NativePath + """" + EndOfLine)</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>MessageBox(error.Message)</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
